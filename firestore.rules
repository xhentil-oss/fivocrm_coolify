rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──

    // Check if user is authenticated
    function isAuth() {
      return request.auth != null;
    }

    // ── Team-Scoped Collections ──
    // Data isolation is enforced CLIENT-SIDE in useFirestore.ts (teamId filtering).
    // Server-side: allow any authenticated user to read/write.
    // Note: isTeamMember() cannot be used reliably here because teamMember documents
    // are created with random Firestore IDs (via addDoc), not predictable {teamId}_{uid} paths.

    match /tasks/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /invoices/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /customers/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /leads/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /services/{docId} {
      // Public read: services are a catalogue shown on the public registration page.
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /expenses/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /goals/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /timeEntries/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /projects/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /channels/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /messages/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.createdByUserId == request.auth.uid;
    }

    match /activities/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if false;
    }

    match /invoiceItems/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /taskComments/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.createdByUserId == request.auth.uid;
    }

    match /taskCollaborators/{docId} {
      allow read: if isAuth();
      allow create, update, delete: if isAuth();
    }

    match /clientRequests/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /customIndustries/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /projectComments/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.createdByUserId == request.auth.uid;
    }

    match /serviceInquiries/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    // ── Global Collections (not team-scoped) ──

    match /teams/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth() && resource.data.createdByUserId == request.auth.uid;
    }

    match /teamMembers/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /teamInvites/{docId} {
      // Read is intentionally open: the UUID token is the secret (same pattern as GitHub/Vercel invites).
      // A caller must know the exact token to find the invite; collection scans without a token are harmless.
      allow read: if true;
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /userProfiles/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if false;
    }

    match /notifications/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth();
      allow update: if isAuth() && resource.data.userId == request.auth.uid;
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    match /clientPortalAccess/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update: if isAuth();
      allow delete: if isAuth();
    }

    match /typingIndicators/{docId} {
      allow read, write: if isAuth();
    }

    match /directMessages/{docId} {
      allow read: if isAuth();
      allow create: if isAuth();
      allow update, delete: if isAuth();
    }

    match /milestones/{docId} {
      allow read, write: if isAuth();
    }

    match /workspaceFolders/{docId} {
      allow read, write: if isAuth();
    }

    match /workspaceDriveFiles/{docId} {
      allow read, write: if isAuth();
    }
  }
}
