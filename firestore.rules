rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helper Functions ──

    function isAuth() {
      return request.auth != null;
    }

    // ══════════════════════════════════════════════════════════════════════════
    // TENANT IDENTITY — signed claims first, users/{uid} only as a fallback
    // ══════════════════════════════════════════════════════════════════════════
    // A tenant is a BUSINESS (`businesses/{bid}`). A TEAM (`teams/{tid}`) is a
    // DEPARTMENT INSIDE exactly one business — `teams.businessId` is required and
    // immutable, so the hierarchy is business → team → data.
    //
    // The boundary is read from the ID token (custom claims minted server-side by
    // api/_tenantClaims.ts):
    //     token.bid   businessId  — the isolation key
    //     token.tid   teamId      — the department inside that business
    //     token.roles ['owner'|'admin'|'manager'|…]
    //     token.cid   customerId  — portal clients only
    // The legacy `users/{uid}` marker is still accepted as a FALLBACK for sessions
    // whose token predates the claims rollout. That document is itself validated on
    // write (usersTenantOk below: a key may only be set when a real membership or an
    // owned customer backs it), so the fallback is not a self-attestation hole — but
    // the claim path is preferred because it is server-signed and costs no get().

    function isSuperAdmin() {
      return isAuth() && request.auth.token.get('superAdmin', false) == true;
    }

    function claimBid() { return request.auth.token.get('bid', ''); }
    function claimTid() { return request.auth.token.get('tid', ''); }
    function claimCid() { return request.auth.token.get('cid', ''); }
    function claimRoles() { return request.auth.token.get('roles', []); }

    function userDoc() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function hasUserDoc() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid));
    }

    // STAFF membership of a tenant. Two accepted proofs:
    //   1. `token.bid` — minted server-side ONLY from a real teamMembers row, or
    //   2. the users/{uid} marker, BUT only when an actual membership document
    //      `{teamId}_{uid}` exists to back it.
    //
    // The membership requirement in (2) is NOT redundant: a PORTAL CLIENT may
    // legitimately write `users/{uid}.businessId` (the users rule validates it against
    // their own customer's business), so accepting the marker alone would silently
    // promote every client to staff of the tenant they belong to — read access to
    // expenses, salaries, goals, reports. Clients have no membership, so they fail here
    // and reach their own data via isPortalClientFor / isPortalClientOfBusiness.
    function isBusinessMember(businessId) {
      return isAuth()
        && businessId is string
        && businessId != ''
        && (
          claimBid() == businessId
          || (hasUserDoc()
              && userDoc().get('businessId', '') == businessId
              && userDoc().get('teamId', '') != ''
              && membershipActive(userDoc().teamId, request.auth.uid))
        );
    }

    // Does this membership row exist AND is it still active? An `Inactive` member
    // (off-boarded, but the row kept for payroll history) must not keep the access
    // the row used to grant. Same cost as the bare exists() it replaces (one read),
    // and the signed-claim path stays primary — api/_tenantClaims.ts already skips
    // inactive memberships when it mints `bid`/`tid`.
    function membershipActive(teamId, uid) {
      return exists(membershipRef(teamId, uid))
        && get(membershipRef(teamId, uid)).data.get('status', 'Active') != 'Inactive';
    }

    // Elevated authority inside the tenant (settings, credentials, member management).
    function isBusinessAdmin(businessId) {
      return isBusinessMember(businessId)
        && ('admin' in claimRoles() || 'owner' in claimRoles() || 'manager' in claimRoles());
    }
    // The OWNER/ADMIN tier only — a Manager is deliberately NOT in it. Used where
    // the action signs off the books for the whole tenant (the month close): a
    // manager runs a department, an admin answers for the company's accounts.
    function isBusinessOwnerOrAdmin(businessId) {
      return isBusinessMember(businessId)
        && ('admin' in claimRoles() || 'owner' in claimRoles());
    }

    // Department membership. `{teamId}_{uid}` is the deterministic membership id
    // (the backfill-member-keys job guarantees it), so this is corroborated server-side.
    function isTeamMember(teamId) {
      return isAuth()
        && teamId is string
        && teamId != ''
        && (
          claimTid() == teamId
          || membershipActive(teamId, request.auth.uid)
          || (hasUserDoc() && userDoc().get('teamId', '') == teamId)
        );
    }

    // ── Tenant lifecycle: a suspended tenant is read-only ──
    // Enterprise/billing requirement: suspend-for-non-payment must be enforced by the
    // database, not the UI. An absent business doc → treated as active, so legacy
    // tenants (and the agency's own data) are never accidentally frozen.
    function tenantActive(businessId) {
      return !(businessId is string) || businessId == ''
        || !exists(/databases/$(database)/documents/businesses/$(businessId))
        || get(/databases/$(database)/documents/businesses/$(businessId)).data.get('status', 'active') != 'suspended';
    }

    // Verify that a team-scoped doc belongs to a team the user is a member of.
    // Because teamMember docs currently use random IDs (addDoc), we cannot do a
    // direct exists() lookup.  Instead we verify that the request comes from an
    // authenticated user and — for writes — that the teamId on the document
    // matches what the client claims.  This is a stepping-stone: once teamMember
    // docs are re-keyed to `{teamId}_{uid}`, swap in the exists() version above.
    function ownsTeamDoc() {
      return isAuth() && resource.data.teamId is string;
    }

    function canCreateForTeam() {
      return isAuth() && request.resource.data.teamId is string;
    }

    // Check that the authenticated user created the team (team owner).
    // Used as a guard for sensitive team-level writes (teamSettings, etc.)
    function teamRef(teamId) {
      return /databases/$(database)/documents/teams/$(teamId);
    }
    function isTeamOwner(teamId) {
      return isAuth()
        && teamId is string
        && exists(teamRef(teamId))
        && get(teamRef(teamId)).data.createdByUserId == request.auth.uid;
    }

    // Who may manage the staff roster (add / edit / remove members, set pay).
    //
    // `isTeamOwner` alone was too narrow: it only recognises the person who
    // CREATED the team (teams/{teamId}.createdByUserId). A business owner whose
    // teams were created by someone else — or any Admin — was locked out of the
    // roster entirely, including their own salary.
    //
    // The `owner`/`admin` claims are just as server-trustworthy as the
    // createdByUserId lookup: api/_tenantClaims.ts mints `owner` ONLY for teams
    // whose createdByUserId is this uid, and `admin` from the member's own
    // teamMembers.role. This is NOT the "client-side admin gating" the old comment
    // warned about — that was a UI check, this is a signed token.
    //
    // `manager` is deliberately EXCLUDED (isBusinessAdmin would have included it):
    // roster writes carry monthlySalary and role, which is authority a department
    // lead should not hold.
    // Holds an owner/admin authority marker inside `businessId`.
    function hasRosterAuthority(businessId) {
      return isBusinessMember(businessId)
        && ('owner' in claimRoles() || 'admin' in claimRoles());
    }

    // For an EXISTING row: the businessId/teamId come from the stored document, so
    // they were written by a trusted path. Deliberately tolerant of legacy rows
    // whose businessId drifted from their team's — being strict here would deny an
    // owner the very edit this change exists to enable.
    function canManageMembers(businessId, teamId) {
      return isSuperAdmin()
        || isTeamOwner(teamId)
        || hasRosterAuthority(businessId);
    }

    // For a NEW row: businessId and teamId are attacker-controlled, and they are
    // NOT interchangeable. `isTeamMember()` is satisfied merely by the existence of
    // `teamMembers/{teamId}_{uid}`, and a dozen rules grant access on that alone —
    // so if authority could be proved against a businessId while the row named a
    // team from a DIFFERENT business, an admin of their own tenant would mint
    // themselves into somebody else's team. The team's real business is therefore
    // read from the team document and both must agree.
    //
    // The team-owner branch is held to the SAME agreement: a team's creator could
    // otherwise write a row naming their own team but a VICTIM businessId, and
    // `/api/sync-claims` would mint `bid` for that business from the row.
    function canCreateMembership(businessId, teamId) {
      return isSuperAdmin()
        || (businessOfTeam(teamId) == businessId
            && (isTeamOwner(teamId) || hasRosterAuthority(businessId)));
    }

    // The business document's owner (self-signup writes `ownerId` first, then the
    // first team, then their own Admin membership — this is what lets that chain
    // through before any claim exists).
    function isBusinessOwner(businessId) {
      return isAuth()
        && businessId is string && businessId != ''
        && exists(/databases/$(database)/documents/businesses/$(businessId))
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.get('ownerId', '') == request.auth.uid;
    }

    // The business a team belongs to (a TEAM LIVES INSIDE A BUSINESS). Used by the
    // `teamSettings` and `counters` rules, whose document ids encode a teamId while
    // authorization is a BUSINESS-level question.
    //
    // This function was previously CALLED in four places but never declared, which
    // the rules compiler reports only as a warning ("Invalid function name"). At
    // runtime an undefined call makes the whole expression error, and an errored
    // condition denies — so `teamSettings` reads/writes and the invoice-number
    // `counters` would have been denied for everyone once deployed.
    //
    // Returns '' for a missing/blank team, and `isBusinessMember('')` is false, so an
    // unresolvable team fails closed rather than granting access.
    function businessOfTeam(teamId) {
      return teamId is string && teamId != '' && exists(teamRef(teamId))
        ? get(teamRef(teamId)).data.get('businessId', '')
        : '';
    }
    // Owner, or an Admin/Manager membership of that team — may invite + configure.
    function isTeamAdmin(teamId) {
      return isSuperAdmin()
        || isTeamOwner(teamId)
        || (isAuth()
            && teamId is string
            && exists(membershipRef(teamId, request.auth.uid))
            && get(membershipRef(teamId, request.auth.uid)).data.get('role', '') in ['Admin', 'Manager']
            && get(membershipRef(teamId, request.auth.uid)).data.get('status', 'Active') != 'Inactive');
    }

    // Staff write guard for tenant CRM records. Safe because reads are already
    // businessId-scoped, so any doc a staff user can open to edit carries a
    // businessId matching their own; super-admins manage cross-tenant.
    function canManageBusinessDoc() {
      return isSuperAdmin()
        || (isBusinessMember(resource.data.businessId) && tenantActive(resource.data.businessId));
    }

    // CREATE guard (enterprise "you can't write outside your tenant"): the NEW
    // doc's businessId MUST be the writer's own business. Enforced at the rules
    // layer so a buggy/hostile client can never stamp another tenant's id — the
    // isolation no longer depends on the app code being correct.
    function canCreateBusinessDoc() {
      return isSuperAdmin()
        || (isBusinessMember(request.resource.data.businessId)
            && tenantActive(request.resource.data.businessId));
    }

    // PORTAL self-service create, TENANT-BOUND: a portal client creating a record
    // "as themselves" (createdByUserId == uid) INSIDE the business they are a client
    // of (`pbid` claim, or users.customerId → customer.businessId). The old version
    // checked only the uid, so any signed-in user could create a customer / lead /
    // request / comment / inquiry stamped into ANY tenant. Staff never need this
    // branch (canCreateBusinessDoc covers them) — keeping them out of it is what
    // lets the per-collection Viewer gate hold.
    // Used by: leads (inquiry lead), clientRequests, projectComments,
    // serviceInquiries, shopOrders, reportComments — each with its own extra pin.
    function isSelfCreate() {
      return isAuth()
        && request.resource.data.get('createdByUserId', '') == request.auth.uid
        && isPortalClientOfBusiness(request.resource.data.get('businessId', ''));
    }

    // A token whose e-mail Firebase has VERIFIED. Everything that keys on the
    // e-mail alone (portal first login, "which customer am I") must require this:
    // a password sign-up with somebody else's address is otherwise indistinguishable
    // from that person, and that was a portal account takeover by e-mail.
    function verifiedEmail() {
      return isAuth()
        && request.auth.token.email != null
        && request.auth.token.get('email_verified', false) == true;
    }
    function tokenEmail() {
      return request.auth.token.email.lower();
    }

    // Portal FIRST-LOGIN bootstrap (useClientPortal / RegisterView): no `cid`/`pbid`
    // claim exists yet, so the only identity we can trust is the verified token
    // e-mail — the new customer/lead row must be ABOUT that address and created as
    // themselves. The tenant (`businessId`) of a public sign-up is, by design, the
    // portal host's tenant; the row is invisible to that tenant's staff until they
    // act on it, exactly like a landing-page submission.
    function isPortalBootstrapContact() {
      return verifiedEmail()
        && request.resource.data.get('createdByUserId', '') == request.auth.uid
        && request.resource.data.get('email', '') is string
        && request.resource.data.email.lower() == tokenEmail();
    }

    // The business a customer record belongs to ('' when unknown).
    function customerBusiness(customerId) {
      return customerId is string && customerId != '' && exists(usersCustomerRef(customerId))
        ? get(usersCustomerRef(customerId)).data.get('businessId', '')
        : '';
    }

    // `client-<customerId>[-project-<id>]` — the portal thread namespace.
    function isClientChannelId(channelId) {
      return channelId is string && channelId.size() >= 8 && channelId[0:7] == 'client-';
    }
    // May the caller write into this client thread? The portal client (own
    // customer, via users.customerId) or STAFF of the customer's business — one
    // get() on the customer, no users/{uid} marker needed for staff.
    function canWriteClientChannel(channelId) {
      return isClientChannelId(channelId)
        && (isSuperAdmin()
            || isBusinessMember(customerBusiness(channelId.split('-')[1]))
            || canAccessClientChannel(channelId));
    }

    // May I address this user directly (DM, scheduled DM, thread head)? Only inside
    // my own tenant: same test as notifications, plus the membership row of my own
    // department for a colleague whose users/{uid} marker predates businessId.
    function isUserInMyTenant(targetUid) {
      return targetUid is string && targetUid != ''
        && (notifyTargetInMyTenant(targetUid)
            || (claimTid() != '' && membershipActive(claimTid(), targetUid)));
    }

    // UPDATE guard: the tenant key is immutable — an edit may never move a doc to
    // another business (blocks tenant-hopping via update). Super-admins may.
    function keepsBusinessId() {
      return isSuperAdmin() || request.resource.data.businessId == resource.data.businessId;
    }

    // Portal client reading their own customer's data. useClientPortal mirrors the
    // portal user's customerId onto users/{uid}.customerId (uid-keyed), so rules can
    // resolve uid → customerId deterministically without re-keying clientPortalAccess.
    function isPortalClientFor(customerId) {
      return isAuth()
        && customerId is string
        && customerId != ''
        && (claimCid() == customerId
            || (hasUserDoc() && userDoc().get('customerId', '') == customerId));
    }

    // A portal user who was added to a project as an explicit MEMBER
    // (projects.memberUserIds) — not the paying customer. One get() on the
    // project; the tasks rule uses it so member-access clients stop seeing
    // "0 detyra / asnjë detyrë" on every project they were invited to.
    function isPortalProjectMember(projectId) {
      return isAuth()
        && projectId is string
        && projectId != ''
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.get('memberUserIds', []) is list
        && request.auth.uid in get(/databases/$(database)/documents/projects/$(projectId)).data.get('memberUserIds', []);
    }

    // The read-only staff role. Minted lowercased into the `roles` claim by
    // api/_tenantClaims.ts; a token that predates the claim carries no roles and
    // is not blocked here (fail-open for legacy tokens, tightened on refresh).
    function isViewerRole() {
      return 'viewer' in claimRoles();
    }

    // Portal client reading their OWN customer doc, whose document id IS the
    // customerId (the customers collection has no self-referential customerId
    // field). Used by the customers read rule.
    function isPortalClientDoc(docId) {
      return isAuth()
        && (claimCid() == docId
            || (hasUserDoc() && userDoc().get('customerId', '') == docId));
    }

    // Access control for client-channel chat messages (channelId = `client-<cid>`
    // or `client-<cid>-project-<pid>`). The portal client owns their own channel;
    // staff are authorized via the message's businessId in the messages rule, with
    // a get(customer) fallback here for legacy messages that predate businessId
    // stamping. Only evaluated when the cheaper businessId clause already failed.
    // Member of a group chat (`channels/{id}` with a `members` array). Evaluable for a
    // LIST query too, because ChatView constrains `channelId` to one literal — which is
    // what makes a group's message list provable: `isBusinessMember(resource.data.
    // businessId)` is unconstrained in that query, so before this every group thread
    // was denied outright for anyone who was not a super-admin (rules test 10d).
    function isGroupChannelMember(channelId) {
      return isAuth()
        && channelId is string
        && channelId != ''
        && exists(/databases/$(database)/documents/channels/$(channelId))
        && get(/databases/$(database)/documents/channels/$(channelId)).data.get('members', []).hasAny([request.auth.uid]);
    }

    function isGroupMemberOf(res) {
      return isAuth() && res.data.get('members', []).hasAny([request.auth.uid]);
    }
    function isGroupAdmin() {
      return isAuth() && (
        resource.data.get('admins', []).hasAny([request.auth.uid])
        || resource.data.get('createdByUserId', '') == request.auth.uid
      );
    }

    function canAccessClientChannel(channelId) {
      return isAuth()
        && channelId is string
        && channelId.size() >= 8
        && channelId[0:7] == 'client-'
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && (
          channelId.split('-')[1] == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.customerId
          || (exists(/databases/$(database)/documents/customers/$(channelId.split('-')[1]))
              && isBusinessMember(get(/databases/$(database)/documents/customers/$(channelId.split('-')[1])).data.businessId))
        );
    }

    // Portal CLIENT belonging to a given BUSINESS. Needed by the shop catalog, which
    // (unlike invoices/quotes) carries no customerId of its own to match on — the
    // client's authorization comes from the tenant, plus the published flag.
    //
    // Preferred path is the signed claims: _tenantClaims mints `cid` for a portal
    // client and derives `bid` from that customer's business, so this costs ZERO
    // document reads. The users/{uid} path remains only for sessions whose token
    // predates the claims rollout; both of its get()s use paths that are identical
    // for every document in a query, so Firestore caches them (two lookups per
    // query, not per document — unlike quoteAccessibleByPortal's per-doc lead get).
    function usersCustomerId() {
      return hasUserDoc() ? userDoc().get('customerId', '') : '';
    }
    function isPortalClientOfBusiness(businessId) {
      return isAuth()
        && businessId is string
        && businessId != ''
        && (
          // `pbid` (portal business id) is a DIFFERENT claim from the staff `bid`, so a
          // portal client can never be mistaken for staff of that business.
          request.auth.token.get('pbid', '') == businessId
          || (usersCustomerId() != ''
              && exists(/databases/$(database)/documents/customers/$(usersCustomerId()))
              && get(/databases/$(database)/documents/customers/$(usersCustomerId()))
                   .data.get('businessId', '') == businessId)
        );
    }

    // May the caller notify this user? Only inside their own tenant: either the target
    // is staff of the same business, or they are a PORTAL CLIENT of it (their users doc
    // carries customerId, not businessId — so resolve through the customer record).
    function notifyTargetInMyTenant(targetUid) {
      return exists(/databases/$(database)/documents/users/$(targetUid))
        && (
          isBusinessMember(get(/databases/$(database)/documents/users/$(targetUid)).data.get('businessId', ''))
          || (get(/databases/$(database)/documents/users/$(targetUid)).data.get('customerId', '') != ''
              && exists(/databases/$(database)/documents/customers/$(
                   get(/databases/$(database)/documents/users/$(targetUid)).data.customerId))
              && isBusinessMember(get(/databases/$(database)/documents/customers/$(
                   get(/databases/$(database)/documents/users/$(targetUid)).data.customerId)).data.get('businessId', '')))
        );
    }

    // A quote is accessible to a portal client when it is stamped with their
    // customerId, OR it is linked to a lead that belongs to their customer.
    // The portal queries quotes by `customerId ==` and by `leadId in [my leads]`,
    // so the per-doc rule holds for both narrowed queries. The lead lookup costs
    // one get() per quote read (quotes are few per client).
    function quoteAccessibleByPortal() {
      return isPortalClientFor(resource.data.customerId)
        || (resource.data.leadId is string
            && exists(/databases/$(database)/documents/leads/$(resource.data.leadId))
            && isPortalClientFor(get(/databases/$(database)/documents/leads/$(resource.data.leadId)).data.customerId));
    }

    // ── Tenant-key validation (hardened cutover) ──
    // The tenant boundary must NOT trust a client-written users/{uid}.businessId.
    // A user may set the tenant keys on their OWN users doc ONLY when they are backed by
    // a real membership (staff) or a customer they own (portal); businessId is validated
    // as a side-effect of whichever key is present, and can never be set on its own.
    function membershipRef(teamId, uid) {
      return /databases/$(database)/documents/teamMembers/$(teamId + '_' + uid);
    }
    function usersCustomerRef(cid) {
      return /databases/$(database)/documents/customers/$(cid);
    }
    // Each tenant key present on the write is validated INDEPENDENTLY, so neither a
    // staff user nor a portal client can inject a key that isn't theirs (e.g. staff
    // planting a customerId to read a victim's portal data).
    function usersTenantOk(userId) {
      return usersTeamFieldOk(userId) && usersCustomerFieldOk(userId) && usersBusinessFieldOk(userId);
    }
    function usersTeamFieldOk(userId) {
      return !('teamId' in request.resource.data)
        || (request.resource.data.teamId is string
            && exists(membershipRef(request.resource.data.teamId, userId)));
    }
    // The customer key is claimed by e-mail match, so the e-mail must be VERIFIED:
    // users/{uid}.customerId is what isPortalClientFor / canAccessClientChannel fall
    // back to, i.e. a password sign-up with a client's address could otherwise read
    // that client's invoices, quotes and chat through this one marker.
    function usersCustomerFieldOk(userId) {
      return !('customerId' in request.resource.data)
        || (request.resource.data.customerId is string
            && verifiedEmail()
            && exists(usersCustomerRef(request.resource.data.customerId))
            && get(usersCustomerRef(request.resource.data.customerId)).data.email
                 == tokenEmail());
    }
    function usersBusinessFieldOk(userId) {
      // businessId must match the business of a present, already-validated teamId or customerId.
      return !('businessId' in request.resource.data)
        || (('teamId' in request.resource.data)
            && get(membershipRef(request.resource.data.teamId, userId)).data.businessId
                 == request.resource.data.businessId)
        || (('customerId' in request.resource.data)
            && get(usersCustomerRef(request.resource.data.customerId)).data.businessId
                 == request.resource.data.businessId);
    }

    // ── Team-Scoped Collections ──
    // Reads: authenticated only.  The client fetches all docs and filters by
    // teamId client-side (to support legacy docs without teamId and to avoid
    // composite-index requirements).  Once teamMember docs are re-keyed to
    // {teamId}_{uid}, reads can be tightened to ownsTeamDoc().
    // Writes: the document must carry a valid teamId string.

    match /tasks/{docId} {
      // Staff via businessId; portal client reads their own customer's tasks
      // (customerId derived from the parent project — see backfill-customerid)
      // or the tasks of a project they are an explicit member of.
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isPortalProjectMember(resource.data.projectId)
        || isSuperAdmin();
      // STAFF ONLY. The portal has no legitimate task write (it only reads its
      // project's tasks; the sales follow-up task is minted server-side via
      // /api/notify-staff with the Admin SDK), and the old `|| isSelfCreate()` /
      // `|| isPortalClientFor(...)` clauses let any signed-in user create a task
      // stamped into ANY tenant, and let a portal client complete or delete
      // internal work items from the browser console — same hole class that was
      // already closed for invoices.
      // A Viewer is read-only by role; until now the UI was the only gate and
      // the detail panel did not even apply it (test 39d).
      // Assignment (82a), the pinned keys (82b), the client-visibility key
      // (82c, 84c) and the project link (84g — a real project of the same
      // business) are checked too.
      // Created AS YOURSELF (useMutation stamps createdByUserId = uid; a next
      // recurring occurrence is created by its completer — the original creator
      // must ride in a separate field, never here).
      allow create: if canCreateBusinessDoc() && !isViewerRole()
        && (isSuperAdmin() || request.resource.data.get('createdByUserId', '') == request.auth.uid)
        && taskAssigneeAllowed(request.resource.data.businessId, request.resource.data.get('teamId', ''), null)
        && taskProjectAllowed(null)
        && taskCustomerAllowed(null, null)
        && (isSuperAdmin() || !request.resource.data.keys().hasAny(taskServerOnlyKeys()));
      // teamId and createdByUserId are pinned (a department / authorship never
      // moves by edit — the cron, Admin SDK, bypasses rules for its own repairs);
      // a legacy row with no teamId may be given one of its own business.
      // Money (84b), the engine flags (84f) and the approval history (84e) have
      // their own gates below.
      allow update: if canManageBusinessDoc() && keepsBusinessId() && !isViewerRole()
        && (isSuperAdmin()
            || (request.resource.data.get('createdByUserId', null) == resource.data.get('createdByUserId', null)
                && (request.resource.data.get('teamId', null) == resource.data.get('teamId', null)
                    || (resource.data.get('teamId', '') == ''
                        && businessOfTeam(request.resource.data.get('teamId', '')) == resource.data.businessId))))
        && taskAssigneeAllowed(resource.data.businessId, resource.data.get('teamId', ''),
                               resource.data.get('assignedToUserId', null))
        && taskProjectAllowed(resource.data.get('projectId', null))
        && taskCustomerAllowed(resource.data.get('customerId', null), resource.data.get('projectId', null))
        && taskMoneyAllowed()
        && taskEngineFlagsAllowed()
        && taskServerKeysUnchanged()
        && taskApprovalStaffAllowed()
        && taskSeenUntouchedOrCleared();
      // "Parë" (src/lib/taskReceipts.ts): the ASSIGNEE stamps that they opened the
      // task — only the two seen keys, only for themselves, at request.time. A
      // dedicated branch so a Viewer who is the assignee can mark it too (seen is
      // not an edit) and nobody can forge it for someone else (tests 83a-83b).
      allow update: if isAuth()
        && resource.data.get('assignedToUserId', '') == request.auth.uid
        && isBusinessMember(resource.data.businessId)
        && tenantActive(resource.data.businessId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['assigneeSeenAt', 'assigneeSeenFor'])
        && request.resource.data.get('assigneeSeenFor', '') == request.auth.uid
        && request.resource.data.get('assigneeSeenAt', null) == request.time;
      // The PORTAL client's decision on a pending approval round (src/lib/taskApproval.ts,
      // tests 83c-83f): the task's own client (or a portal member of its project) may
      // write ONLY clientApproval.{state, decidedAt, decidedByUid, decisionNote}
      // (+ status -> In Progress when asking for changes, + updatedAt). Approval never
      // completes the task — completion stays staff's completeTask() flow.
      allow update: if taskClientDecision();
      allow delete: if canManageBusinessDoc() && !isViewerRole();
    }

    // Staff side of the client approval: the round may only be OPENED (pending,
    // requested as yourself, on a portal-visible task) or WITHDRAWN (cancelled) —
    // by an Admin/Manager or the task's assignee/creator. Staff can never write a
    // client decision (approved / changes_requested) into it.
    // `clientApprovalHistory` ("Raundet e mëparshme") rides under the SAME gate:
    // the only legitimate write is buildApprovalRequestPatch (src/lib/
    // taskApproval.ts) moving the decided round into history while it opens the
    // next pending one — so a history write must come with a legal round write by
    // one of those people. A colleague could otherwise plant a forged "approved"
    // round from the console (test 84e). The portal's own branch (taskClientDecision)
    // never touches it.
    function taskApprovalStaffAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['clientApproval', 'clientApprovalHistory'])
        || isSuperAdmin()
        || (request.resource.data.get('clientApproval', null) is map
            && request.resource.data.clientApproval.get('state', '') in ['pending', 'cancelled']
            && (isBusinessAdmin(resource.data.businessId)
                || resource.data.get('assignedToUserId', '') == request.auth.uid
                || resource.data.get('createdByUserId', '') == request.auth.uid)
            && (request.resource.data.clientApproval.get('state', '') != 'pending'
                || (request.resource.data.clientApproval.get('requestedByUserId', '') == request.auth.uid
                    && request.resource.data.get('customerId', '') != '')));
    }
    // The seen mark is the assignee's own (branch above). Any other write may only
    // leave it alone or CLEAR it (a reassignment resets it).
    function taskSeenUntouchedOrCleared() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['assigneeSeenAt', 'assigneeSeenFor'])
        || (request.resource.data.get('assigneeSeenAt', null) == null
            && request.resource.data.get('assigneeSeenFor', null) == null);
    }
    function taskClientDecision() {
      return isAuth()
        && resource.data.get('customerId', '') != ''
        && (isPortalClientFor(resource.data.get('customerId', ''))
            || isPortalProjectMember(resource.data.get('projectId', '')))
        && tenantActive(resource.data.get('businessId', ''))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clientApproval', 'status', 'updatedAt'])
        && resource.data.get('clientApproval', null) is map
        && resource.data.clientApproval.get('state', '') == 'pending'
        && request.resource.data.clientApproval is map
        && request.resource.data.clientApproval.diff(resource.data.clientApproval).affectedKeys()
             .hasOnly(['state', 'decidedAt', 'decidedByUid', 'decisionNote'])
        && request.resource.data.clientApproval.get('decidedByUid', '') == request.auth.uid
        && request.resource.data.clientApproval.get('decidedAt', null) == request.time
        && (request.resource.data.clientApproval.get('decisionNote', null) == null
            || (request.resource.data.clientApproval.decisionNote is string
                && request.resource.data.clientApproval.decisionNote.size() <= 2000))
        && (request.resource.data.get('updatedAt', null) == resource.data.get('updatedAt', null)
            || request.resource.data.get('updatedAt', null) == request.time)
        && (
          (request.resource.data.clientApproval.state == 'approved'
            && request.resource.data.get('status', '') == resource.data.get('status', ''))
          || (request.resource.data.clientApproval.state == 'changes_requested'
            && request.resource.data.clientApproval.get('decisionNote', null) is string
            && request.resource.data.clientApproval.decisionNote.size() > 0
            && request.resource.data.get('status', '') in [resource.data.get('status', ''), 'In Progress'])
        );
    }

    // "Cakto detyra te të tjerët" (CLAUDE.md → Roles: canAssignTasks). Handing a
    // task to SOMEONE ELSE needs either an assigning role (Admin/Manager/
    // SalesAgent, owner — the `roles` claim) or the per-member grant
    // `teamMembers.canAssignTasks` on the caller's membership row of the active
    // department (`tid` claim) or of the task's own department. Assigning to
    // yourself, clearing the assignee, or leaving it unchanged is always fine.
    // A NEXT OCCURRENCE of a recurring series is created by whoever completed
    // the previous one and inherits its assignee — allowed when `seriesId`
    // names a real recurring task of the same business (the browser half of
    // the recurring-tasks engine, src/lib/recurringUtils.ts).
    // Known approximation: a person whose grant sits on a row of a THIRD team
    // (neither the active one nor the task's) is refused here although
    // grantsCanAssignTasks() allows it in the UI — rules cannot scan rows.
    function membershipGrantsAssign(teamId) {
      return teamId is string && teamId != ''
        && exists(membershipRef(teamId, request.auth.uid))
        && get(membershipRef(teamId, request.auth.uid)).data.get('status', 'Active') == 'Active'
        && (get(membershipRef(teamId, request.auth.uid)).data.get('canAssignTasks', false) == true
            || get(membershipRef(teamId, request.auth.uid)).data.get('role', '') in ['Admin', 'Manager', 'SalesAgent']);
    }
    function continuesRecurringSeries(businessId) {
      return request.resource.data.get('isRecurring', false) == true
        && request.resource.data.get('seriesId', '') is string
        && request.resource.data.get('seriesId', '') != ''
        && exists(/databases/$(database)/documents/tasks/$(request.resource.data.seriesId))
        && get(/databases/$(database)/documents/tasks/$(request.resource.data.seriesId)).data.get('businessId', '') == businessId
        && get(/databases/$(database)/documents/tasks/$(request.resource.data.seriesId)).data.get('isRecurring', false) == true;
    }
    function taskAssigneeAllowed(businessId, teamId, previousAssignee) {
      return request.resource.data.get('assignedToUserId', null) == null
        || request.resource.data.get('assignedToUserId', null) == ''
        || request.resource.data.get('assignedToUserId', null) == request.auth.uid
        || request.resource.data.get('assignedToUserId', null) == previousAssignee
        || isSuperAdmin()
        || claimRoles().hasAny(['owner', 'admin', 'manager', 'salesagent'])
        || isBusinessOwner(businessId)
        || membershipGrantsAssign(claimTid())
        || membershipGrantsAssign(teamId)
        || (previousAssignee == null && continuesRecurringSeries(businessId));
    }

    // The task's money (src/lib/finance/taskValue.ts: `value` prices the task and
    // drafts an invoice; `valueAppliedToBudget` is the budget-increment claim) is
    // Admin/Manager work in the RULES, like the project's own budget
    // (projectFinanceKeys) — the UI only hid it (`canEditBudget`). A Member may
    // spread the stored value unchanged (projKeySame tolerates null/0/absent as
    // one "nothing"), never set or move it (test 84b).
    function taskMoneyAllowed() {
      return (projKeySame('value') && projKeySame('valueAppliedToBudget'))
        || isSuperAdmin()
        || isBusinessAdmin(resource.data.businessId);
    }

    // The engine flags are NOT cron-only — the browser writes them too: the
    // recurrence claim (src/lib/taskRecurrenceClaim.ts) and completeTask set
    // `nextCycleCreated`, the re-open / "Përsërit deri" paths give it back,
    // every deadline edit re-arms `dueNotificationSent` / `overdueNotificationSent`
    // (panelShared.rearmDeadlineAlerts) and a reminder edit clears `reminderSentAt`
    // (taskReminders.setReminderPatch). But they belong to the task's OWNER: the
    // assignee, the creator or an Admin/Manager. A random colleague flipping
    // `nextCycleCreated` on a series kills it (true) or doubles it (false) with
    // no trace, and a silenced alert flag is a notification that never fires.
    // The one thing any other non-Viewer staff may do is RE-ARM (write false /
    // null — what a deadline edit on a colleague's task spreads): it costs at
    // most a repeated notification, never a lost cycle (test 84f).
    // `nextCycleTaskId` / `recurringClaimRepairedAt` are written by the same claim
    // transaction as `nextCycleCreated` (the child's id, and the take-over of a
    // claim proved empty); `reminderSkippedAt` / `reminderSkippedReason` are the
    // cron's "consumed without a send" marks, which the browser only CLEARS
    // (setReminderPatch → null), like `reminderSentAt`.
    function taskEngineFlagKeys() {
      return ['nextCycleCreated', 'nextCycleTaskId', 'recurringClaimRepairedAt', 'recurringSkippedReason',
              'reminderSentAt', 'reminderSkippedAt', 'reminderSkippedReason',
              'dueNotificationSent', 'overdueNotificationSent'];
    }
    // SERVER-ONLY task keys (recurring-project-reset / recurring-tasks cron, Admin
    // SDK): the period the reset already applied to this task, the occurrence
    // roll ledger and the due-date month anchor the reset moves. Never born in a
    // browser create, never changed by a browser update (an unchanged spread is
    // fine — projKeySame). Same law as projectRollupKeys (test 84l).
    function taskServerOnlyKeys() {
      return ['recurringOccurrencesRolled', 'recurringOccurrencesRolledAt', 'workCycleAppliedPeriodKey', 'cycleAnchorDueDay'];
    }
    function taskServerKeysUnchanged() {
      return isSuperAdmin()
        || (projKeySame('recurringOccurrencesRolled') && projKeySame('recurringOccurrencesRolledAt')
            && projKeySame('workCycleAppliedPeriodKey') && projKeySame('cycleAnchorDueDay'));
    }
    function taskEngineOwner() {
      return isSuperAdmin()
        || isBusinessAdmin(resource.data.businessId)
        || resource.data.get('assignedToUserId', '') == request.auth.uid
        || resource.data.get('createdByUserId', '') == request.auth.uid;
    }
    function taskFlagUntouchedOrRearmed(k, armed) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([k])
        || request.resource.data.get(k, armed) == armed;
    }
    function taskEngineFlagsAllowed() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(taskEngineFlagKeys())
        || taskEngineOwner()
        || (!request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['nextCycleCreated', 'nextCycleTaskId', 'recurringClaimRepairedAt', 'recurringSkippedReason'])
            && taskFlagUntouchedOrRearmed('dueNotificationSent', false)
            && taskFlagUntouchedOrRearmed('overdueNotificationSent', false)
            && taskFlagUntouchedOrRearmed('reminderSentAt', null)
            && taskFlagUntouchedOrRearmed('reminderSkippedAt', null)
            && taskFlagUntouchedOrRearmed('reminderSkippedReason', null));
    }

    // `projectId` names a PROJECT OF THE SAME BUSINESS whenever it is set or
    // changed (create and update; one get(), shared with customerOfProjectIs).
    // Unchanged / cleared is always fine — a task whose project was deleted must
    // stay editable. Before, the project was validated only when a customerId
    // was set next to it, so a Member could point a task at another tenant's
    // project id (test 84g).
    function sameRef(a, b) {
      return a == b || (isEmptyValue(a) && isEmptyValue(b));
    }
    function taskProjectAllowed(previousProjectId) {
      return isEmptyValue(request.resource.data.get('projectId', null))
        || (previousProjectId != null && request.resource.data.get('projectId', null) == previousProjectId)
        || isSuperAdmin()
        || projectInBusiness(request.resource.data.get('projectId', null), request.resource.data.businessId);
    }
    function projectInBusiness(projectId, businessId) {
      return projectId is string && projectId != ''
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.get('businessId', '') == businessId;
    }

    // customerId on a task IS the portal-visibility switch (the client reads
    // `customerId == mine`). It may be: unchanged — but only while the task stays
    // on the same project: a task moved to another project must be re-derived
    // (TaskPeopleRows.changeProject sends the NEW project's customer or '', and
    // that is what is accepted — keeping the old client across a move left them
    // reading a task that is no longer theirs, test 84c) —, cleared, the customer
    // of the task's own project (useFirestore derives it from the project on
    // create; TaskDetailPanel / ProjectsView re-derive it on a project move or a
    // change of the project's customer), the customer of the parent task (a
    // subtask) or of the series root (a next occurrence) in the same business — or
    // any customer of the same business when an Admin/Manager sets it by hand.
    // Anything else would publish an internal task to another client's portal.
    function taskCustomerAllowed(previousCustomerId, previousProjectId) {
      return request.resource.data.get('customerId', null) == null
        || request.resource.data.get('customerId', null) == ''
        || (request.resource.data.get('customerId', null) == previousCustomerId
            && sameRef(request.resource.data.get('projectId', null), previousProjectId))
        || isSuperAdmin()
        || customerOfProjectIs(request.resource.data.get('projectId', ''), request.resource.data.customerId)
        || customerOfTaskIs(request.resource.data.get('parentTaskId', ''), request.resource.data.customerId)
        || customerOfTaskIs(request.resource.data.get('seriesId', ''), request.resource.data.customerId)
        || (isBusinessAdmin(request.resource.data.businessId)
            && customerBusiness(request.resource.data.customerId) == request.resource.data.businessId);
    }
    function customerOfProjectIs(projectId, customerId) {
      return projectId is string && projectId != ''
        && exists(/databases/$(database)/documents/projects/$(projectId))
        && get(/databases/$(database)/documents/projects/$(projectId)).data.get('businessId', '') == request.resource.data.businessId
        && get(/databases/$(database)/documents/projects/$(projectId)).data.get('customerId', '') == customerId;
    }
    function customerOfTaskIs(taskId, customerId) {
      return taskId is string && taskId != ''
        && exists(/databases/$(database)/documents/tasks/$(taskId))
        && get(/databases/$(database)/documents/tasks/$(taskId)).data.get('businessId', '') == request.resource.data.businessId
        && get(/databases/$(database)/documents/tasks/$(taskId)).data.get('customerId', '') == customerId;
    }

    // ── Phase 4.3b: crown-jewel CRM records — server-side tenant RLS.
    // Staff read via businessId; the portal client reads their own customer's
    // records (users/{uid}.customerId mirrored by useClientPortal); super-admin
    // bypasses. The portal already queries these with `where customerId == myId`,
    // so the per-doc rule holds for every doc the narrowed query returns.
    match /invoices/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isSuperAdmin();
      // A non-admin creates Draft/Pending/Sent/Overdue invoices only — born-Paid
      // would be the settlement below through a side door.
      allow create: if canCreateBusinessDoc() && !isViewerRole()
        && (isSuperAdmin()
            || isBusinessAdmin(request.resource.data.businessId)
            || (!request.resource.data.keys().hasAny(invoiceSettlementKeys())
                && !(request.resource.data.get('status', '') in invoiceSettlementStatuses())));
      // STAFF ONLY. The portal client must never write an invoice: the portal has no
      // legitimate invoice write (payment goes through Stripe → webhook, Admin SDK),
      // and the old `|| isPortalClientFor(...)` clause let a client mark their own
      // invoice Paid from the browser console — or delete the accounting record.
      // `customerId` is deliberately NOT pinned: InvoicesView lets staff re-assign
      // an invoice to another customer of the same tenant.
      // SETTLEMENT is Admin/Manager only (`invoiceSettlementAllowed`): a plain
      // Member drafts and edits invoices, but "this money was received" — the
      // status flip to Paid/Partial/Cancelled, `paidAt`, the instalments, the
      // WHMCS write-back queue and the Stripe binding — is the accounting fact
      // every P&L, cash-flow alarm and WHMCS push reads. The check is on the
      // CHANGED keys only, so an edit that spreads those fields unchanged passes.
      allow update: if canManageBusinessDoc() && keepsBusinessId() && !isViewerRole()
        && invoiceSettlementAllowed()
        && invoiceAmountsAllowed()
        && invoiceBankAllowed();
      // Only a Draft was never issued: once an invoice has gone to the client
      // (or been paid / cancelled) it is an accounting document, and deleting
      // it is the settlement audience's call (Admin/Manager), not a Member's.
      // A legacy row with no status is treated as a Draft.
      allow delete: if canManageBusinessDoc() && !isViewerRole()
        && (isSuperAdmin()
            || isBusinessAdmin(resource.data.businessId)
            || resource.data.get('status', 'Draft') == 'Draft');
    }
    // The amounts of a SETTLED invoice (Paid / Partial / Cancelled) are frozen
    // for a Member: re-pricing an invoice that was paid rewrites the
    // received-vs-owed figure that every P&L, the outstanding total and the
    // WHMCS push read — the same audience as the settlement itself. Checked on
    // the CHANGED keys only, so an edit that spreads them unchanged passes.
    // Where the client is told to PAY. A Member re-pointing an issued invoice's
    // IBAN is the payment-redirect the Oct 2026 audit found on projects; the bank
    // block is the settlement audience's (Admin/Manager), on any status. Changed
    // keys only — an edit that spreads them unchanged passes.
    function invoiceBankKeys() {
      return ['paymentMethod', 'paymentUrl', 'bankName', 'bankIBAN', 'bankSWIFT', 'bankAccountHolder', 'bankCountry'];
    }
    function invoiceBankAllowed() {
      return isSuperAdmin()
        || isBusinessAdmin(resource.data.businessId)
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(invoiceBankKeys());
    }
    function invoiceAmountKeys() {
      return ['total', 'amount', 'subtotal', 'tax', 'discount', 'discountType', 'currency'];
    }
    function invoiceAmountsAllowed() {
      return isSuperAdmin()
        || isBusinessAdmin(resource.data.businessId)
        || !(resource.data.get('status', '') in invoiceSettlementStatuses())
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(invoiceAmountKeys());
    }
    // Is the invoice behind a line item settled? One get() on the parent
    // (cached per request). A missing / unknown parent is not settled.
    function invoiceSettledById(invoiceId) {
      return invoiceId is string && invoiceId != ''
        && exists(/databases/$(database)/documents/invoices/$(invoiceId))
        && get(/databases/$(database)/documents/invoices/$(invoiceId)).data.get('status', '') in invoiceSettlementStatuses();
    }
    function invoiceItemWriteAllowed(invoiceId, businessId) {
      return isSuperAdmin() || isBusinessAdmin(businessId) || !invoiceSettledById(invoiceId);
    }
    function invoiceSettlementKeys() {
      return ['paidAt', 'paidAmount', 'partialPayments', 'payments', 'whmcsPendingPayments',
              'whmcsSyncedPaymentKeys', 'whmcsPaymentPendingAt', 'whmcsPaymentSyncedAt',
              'whmcsPaymentSyncError', 'stripeSessionId', 'stripePaymentIntentId'];
    }
    function invoiceSettlementStatuses() {
      return ['Paid', 'Partial', 'Cancelled'];
    }
    function invoiceSettlementAllowed() {
      return isSuperAdmin()
        || isBusinessAdmin(resource.data.businessId)
        || (
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(invoiceSettlementKeys())
          && (
            !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status'])
            || (!(resource.data.get('status', '') in invoiceSettlementStatuses())
                && !(request.resource.data.get('status', '') in invoiceSettlementStatuses()))
          )
        );
    }

    match /payments/{docId} {
      // Payment ledger (arkëtime). Mirrors invoices' business scoping; portal
      // clients may read their own payments. WRITES are Admin/Manager only — a
      // payment row is the settlement fact itself (see invoiceSettlementAllowed).
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isSuperAdmin();
      allow create: if canCreateBusinessDoc() && !isViewerRole()
        && (isSuperAdmin() || isBusinessAdmin(request.resource.data.businessId));
      allow update: if canManageBusinessDoc() && keepsBusinessId() && !isViewerRole()
        && (isSuperAdmin() || isBusinessAdmin(resource.data.businessId));
      allow delete: if canManageBusinessDoc() && !isViewerRole()
        && (isSuperAdmin() || isBusinessAdmin(resource.data.businessId));
    }

    // ── Hosting & domains module (cPanel/WHM + Dynadot) ──
    // `subscriptions` and `domains` predate the module as WHMCS read-only mirrors
    // (`source: 'whmcs'`); the module adds `source: 'fivocrm'` rows it bills itself.
    // Staff manage their tenant's records directly; a PORTAL CLIENT only reads its
    // own (queries are `customerId == cid`), and every client-side change (SSO,
    // nameservers, auto-renew, cancel, orders) goes through POST /api/hosting, which
    // re-checks ownership — so no client write rule exists for them.
    // Rows are CREATED only server-side (an order, "shto ekzistues" or "merr nën
    // menaxhim" through POST /api/hosting, which verifies the account/domain at the
    // provider first). A browser update may touch notes/tags but never the fields
    // that bind the row to a provider account or drive billing — a staff member who
    // could set `cpanelUsername` by hand could SSO into any account on a shared
    // server, and one who could move `nextDueDate` could bill or suspend at will.
    function subscriptionProtectedKeys() {
      return ['cpanelUsername', 'serverId', 'whmPackage', 'status', 'provisionStatus', 'source',
              'customerId', 'nextDueDate', 'anchorDay', 'currentInvoiceId', 'lastInvoicedDueKey',
              'recurringAmount', 'currency', 'billingCycle', 'cancelAtPeriodEnd', 'lifecycleHold',
              'suspendedAt', 'suspendReason', 'terminatedAt', 'whmcsServiceId'];
    }
    function domainProtectedKeys() {
      return ['domainName', 'tld', 'registrar', 'source', 'status', 'provisionStatus', 'customerId',
              'expiryDate', 'registrationDate', 'years', 'recurringAmount', 'currency', 'autoRenew',
              'currentInvoiceId', 'lastInvoicedExpiryKey', 'renewedAtRegistrarForKey', 'lifecycleHold',
              'nameservers', 'whmcsDomainId'];
    }
    match /domains/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (canManageBusinessDoc() && keepsBusinessId()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(domainProtectedKeys()));
      allow delete: if canManageBusinessDoc() && resource.data.get('source', 'whmcs') != 'fivocrm';
    }
    match /subscriptions/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (canManageBusinessDoc() && keepsBusinessId()
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(subscriptionProtectedKeys()));
      allow delete: if canManageBusinessDoc() && resource.data.get('source', 'whmcs') != 'fivocrm';
    }
    // Per-user rate-limit counters for POST /api/hosting (server-only).
    match /hostingRateLimits/{docId} {
      allow read, write: if false;
    }
    // Coupons: staff-only. A portal client never reads the list (a code is a secret);
    // it is validated server-side by order.quote / order.create. `uses` is bumped by
    // the endpoint, but a staff correction is allowed too.
    match /hostingCoupons/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if canManageBusinessDoc() && keepsBusinessId();
      allow delete: if canManageBusinessDoc();
    }
    // Backups ledger: server-written (pkgacct runs); staff read theirs, a client its own.
    match /hostingBackups/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isSuperAdmin();
      allow write: if false;
    }
    // Servers: hostname/user/nameservers are staff-only. The WHM API TOKEN is never
    // here — it lives in hostingServerSecrets (deny-all), written by the endpoint.
    // A server row decides WHERE accounts are provisioned and which host the VPS
    // relay may reach — Admin/Manager only (HostingView's `isAdmin`), not every member.
    match /hostingServers/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if isSuperAdmin()
        || (isBusinessAdmin(request.resource.data.businessId) && tenantActive(request.resource.data.businessId));
      allow update: if isSuperAdmin()
        || (isBusinessAdmin(resource.data.businessId) && tenantActive(resource.data.businessId) && keepsBusinessId());
      allow delete: if isSuperAdmin() || isBusinessAdmin(resource.data.businessId);
    }
    match /hostingServerSecrets/{docId} {
      allow read, write: if false;
    }
    // Catalog: the portal sees only `portalVisible` rows of its own tenant.
    match /hostingProducts/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || (resource.data.portalVisible == true
            && isPortalClientOfBusiness(resource.data.businessId))
        || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if canManageBusinessDoc() && keepsBusinessId();
      allow delete: if canManageBusinessDoc();
    }
    match /domainTlds/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || (resource.data.get('portalVisible', true) != false
            && isPortalClientOfBusiness(resource.data.businessId))
        || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if canManageBusinessDoc() && keepsBusinessId();
      allow delete: if canManageBusinessDoc();
    }
    // Orders are created ONLY by the endpoint (it prices from the catalog and checks
    // availability), so neither staff nor clients create them from the browser.
    match /hostingOrders/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if canManageBusinessDoc() && keepsBusinessId();
      allow delete: if isSuperAdmin();
    }
    // Provider/lifecycle audit: append-only, server-written.
    match /hostingEvents/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isSuperAdmin();
      allow write: if false;
    }

    match /customers/{docId} {
      // Staff read their business's customers; the portal client reads only their
      // own customer doc (doc id == their customerId); super-admin bypasses.
      // The email clause covers portal bootstrap (useClientPortal queries customers
      // by email to resolve customerId before users/{uid}.customerId exists). It is
      // safe: Firebase verifies the token email, so a user can only match their own.
      // The e-mail clause requires a VERIFIED token e-mail: without that, a password
      // sign-up with a client's address read that client's customer record.
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientDoc(docId)
        || (verifiedEmail() && resource.data.email == tokenEmail())
        || isSuperAdmin();
      // Staff inside their tenant, or the portal bootstrap: a customer row ABOUT the
      // verified token e-mail, created as themselves (useClientPortal / RegisterView).
      allow create: if (canCreateBusinessDoc() && !isViewerRole())
        || isPortalBootstrapContact();
      // The portal client may edit their own profile, but never the STAFF-side
      // follow-up state (next step, last touch, owner) — a client could otherwise
      // hide themselves from the follow-up queue or re-assign their own account.
      allow update: if (canManageBusinessDoc() && keepsBusinessId() && !isViewerRole())
        || (isPortalClientDoc(docId)
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                 'nextFollowUpDate', 'nextFollowUpType', 'followUpNote', 'lastFollowUpDate',
                 'lastActivityAt', 'lastReminderSentAt', 'lastInboundAt', 'awaitingReply',
                 'assignedToUserId', 'status', 'tags', 'businessId', 'teamId', 'email',
                 'createdByUserId', 'waLid', 'waOptOut', 'waOptOutAt', 'waOptInAt',
                 'waUndeliverablePhone', 'waUndeliverableAt', 'waUndeliverableError']));
      // Deleting a CRM record is a staff action. The portal never deletes its own
      // customer (PortalProfileView only updates), and a client erasing the record
      // that invoices/projects hang off would orphan the tenant's books.
      allow delete: if canManageBusinessDoc() && !isViewerRole();
    }

    match /leads/{docId} {
      // Staff read their business's leads (queries are businessId-scoped); the
      // portal client reads only leads stamped with their own customerId (portal
      // query is `where customerId == myId`). Was `if isAuth()` — a cross-tenant
      // leak letting any signed-in user (incl. portal clients) read every tenant's
      // pipeline. Portal creates: RegisterView writes a lead about the registrant's
      // own (verified) e-mail before any claim exists (bootstrap), and
      // PortalInquiryView writes the questionnaire lead inside the client's own
      // tenant (isSelfCreate, tenant-bound). useClientPortal itself no longer
      // creates leads — that moved to /api/link-contact.
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isSuperAdmin();
      allow create: if ((canCreateBusinessDoc() && !isViewerRole())
          || isPortalBootstrapContact()
          || isSelfCreate())
        && leadAgentKeysAbsent();
      allow update: if isSuperAdmin()
        || (canManageBusinessDoc() && keepsBusinessId() && !isViewerRole() && leadAgentKeysUntouched());
      allow delete: if isSuperAdmin() || (canManageBusinessDoc() && !isViewerRole());
    }

    // Qualified opportunities (the Marrëveshjet module). This block was MISSING
    // entirely, so default-deny made the whole pipeline dead for every non-
    // super-admin — reads, kanban stage moves and the lead→deal sync all failed
    // silently. Staff-only; the portal has no deal surface.
    match /deals/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc() && !isViewerRole();
      allow update: if canManageBusinessDoc() && keepsBusinessId() && !isViewerRole();
      allow delete: if canManageBusinessDoc() && !isViewerRole();
    }

    // Lead activity timeline (notes, calls, campaign touches). Also had NO rule
    // — the CRM timeline never loaded for normal staff. Append-only from the
    // client: editing history would let anyone rewrite the audit trail.
    match /leadActivities/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update, delete: if isSuperAdmin();
    }

    match /services/{docId} {
      // WAS `read: if isAuth()` — every tenant's service catalogue + pricing was
      // readable by any signed-in user, including portal clients of other tenants.
      // The portal views now query `businessId == <their own business>`, so the
      // per-document rule can require the tenant match.
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientOfBusiness(resource.data.businessId)
        || isSuperAdmin();
      allow create: if canCreateBusinessDoc() && !isViewerRole();
      allow update: if canManageBusinessDoc() && keepsBusinessId() && !isViewerRole();
      allow delete: if canManageBusinessDoc() && !isViewerRole();
    }

    // ── Shop module (products, catalog taxonomy, inventory, orders) ──
    // Unlike `services` above, the portal read is NOT `isAuth()`: PortalShopView
    // queries `businessId == mine && visibleInPortal == true`, so the per-document
    // rule can require both the tenant match and the published flag. A client can
    // therefore never read another tenant's catalog, nor this tenant's drafts.
    match /products/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || (resource.data.visibleInPortal == true
            && isPortalClientOfBusiness(resource.data.businessId))
        || isSuperAdmin();
      allow create: if canCreateBusinessDoc() && !isViewerRole();
      allow update: if canManageBusinessDoc() && keepsBusinessId() && !isViewerRole();
      allow delete: if canManageBusinessDoc() && !isViewerRole();
    }

    // Taxonomy is not sensitive on its own, but stays tenant-scoped: the portal shop
    // renders category filters, so a client of this business may read them.
    match /productCategories/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientOfBusiness(resource.data.businessId)
        || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if canManageBusinessDoc() && keepsBusinessId();
      allow delete: if canManageBusinessDoc();
    }

    match /productBrands/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientOfBusiness(resource.data.businessId)
        || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if canManageBusinessDoc() && keepsBusinessId();
      allow delete: if canManageBusinessDoc();
    }

    // Inventory ledger: staff only, and append-only by design — cost prices and
    // stock history are never exposed to clients, and edits would destroy the audit
    // trail the stock numbers rely on (corrections are new movements).
    match /stockMovements/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // Orders: staff manage them; a portal client reads their OWN orders and may
    // create one for themselves. Clients cannot update (no self-approving a
    // shipment or rewriting a price) — cancellations go through the team.
    match /shopOrders/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isSuperAdmin();
      // A portal create is pinned to the client themselves, to an unpaid Pending
      // order, and to stock NOT yet applied. Prices are re-computed server-side;
      // what the rules can pin is the MONEY STATE: an order that arrives already
      // `paymentStatus: 'Paid'` makes ShopOrdersView issue an invoice already
      // marked paid, and `stockApplied: true` makes the back office skip the
      // decrement — both are client-authored facts about our own books.
      allow create: if canCreateBusinessDoc()
        || (isPortalClientFor(request.resource.data.customerId)
            && request.resource.data.source == 'portal'
            && request.resource.data.status == 'Pending'
            && request.resource.data.get('paymentStatus', 'Unpaid') == 'Unpaid'
            && request.resource.data.get('stockApplied', false) != true
            && isSelfCreate());
      allow update: if canManageBusinessDoc() && keepsBusinessId();
      allow delete: if canManageBusinessDoc();
    }

    // ══════════════════════════════════════════════════════════════════════════
    // REPORTING & ACCOUNTABILITY MODULE
    // ══════════════════════════════════════════════════════════════════════════
    //
    // The hard requirement: a report holds client-facing AND internal content in the
    // SAME document, so the rules cannot decide visibility per block. They therefore
    // enforce a coarser, verifiable invariant, and the block-level redaction happens
    // in code (`src/lib/reporting/visibility.ts`) on top of it:
    //
    //   1. A client may only read a report that is (a) their own customer's,
    //      (b) PUBLISHED, and (c) not soft-deleted. Drafts, internal-only kinds and
    //      other tenants' reports are denied outright.
    //   2. A client may NEVER write report content. Their two legitimate actions —
    //      acknowledge/approve, and post a non-internal comment — are the only
    //      client writes allowed, and the status transition goes through
    //      `POST /api/reports` (server-side, `canTransition`-guarded) rather than a
    //      direct field write.
    //   3. Versions, approvals and the event stream are APPEND-ONLY for everyone.
    //      An audit trail a client (or a staff member) can edit is not an audit trail.
    //
    // Because the client's own portal query is `businessId == mine && customerId ==
    // mine && status in [published…]`, every per-document clause below holds for the
    // narrowed query — rules are not filters, so the two must agree exactly.

    // Report kinds a client may ever see. `client-risk` and `weekly-staff` are
    // internal instruments and are excluded even if someone marks one published.
    function reportKindIsClientFacing(kind) {
      return kind in ['client-monthly', 'qbr', 'project-status', 'project-completion',
                      'campaign-completion', 'website-launch', 'incident'];
    }

    // Statuses that mean "the client has been given this report".
    function reportIsPublished(status) {
      return status in ['published', 'sent', 'viewed', 'acknowledged',
                        'client_approved', 'client_rejected'];
    }

    // The portal's LIST query must prove this clause from its own `where`
    // filters ("rules are not filters"), and the old conjunction — published
    // status AND client-facing kind AND deletedAt == null — is unprovable by
    // any legal query (one `in` filter max; a missing deletedAt never matches
    // `== null`), so /portal/reports was denied for every real client.
    // `portalVisible` is the denormalized AND of those three, maintained by
    // src/lib/reporting/workflow.ts (transitionPatch/softDelete/restore) and
    // stamped false at creation; the query pins customerId + portalVisible.
    function portalMayReadReport() {
      return isPortalClientFor(resource.data.get('customerId', ''))
        && resource.data.get('portalVisible', false) == true;
    }

    // May the caller edit THIS report? `canManageBusinessDoc()` alone was too broad:
    // it grants any member of the tenant, so a Member could rewrite a colleague's
    // weekly report — or an approved client report — with a direct SDK call. The UI's
    // `canEditContent()` never protected that, it only hid the button.
    //
    // Involvement is read from the EXISTING document, so a writer cannot grant
    // themselves access by putting their own uid into the update payload.
    function involvedInReport() {
      return isAuth() && (
        resource.data.get('authorUserId', '') == request.auth.uid
        || resource.data.get('reviewerUserId', '') == request.auth.uid
        || resource.data.get('approverUserId', '') == request.auth.uid
        || resource.data.get('accountManagerUserId', '') == request.auth.uid
        || resource.data.get('projectManagerUserId', '') == request.auth.uid
      );
    }

    match /reports/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || portalMayReadReport()
        || isSuperAdmin();
      // A report is created AS yourself. An admin may author on someone's behalf
      // (e.g. filing for a member who is away); a plain member may not.
      allow create: if canCreateBusinessDoc()
        && (request.resource.data.get('authorUserId', '') == request.auth.uid
            || isBusinessAdmin(request.resource.data.businessId)
            || isSuperAdmin());
      // Tenant key stays immutable, so an update can never move a report to another
      // business. Client-driven fields are written by the server (admin SDK), which
      // bypasses these rules by design.
      allow update: if canManageBusinessDoc() && keepsBusinessId()
        && (involvedInReport()
            || isBusinessAdmin(resource.data.businessId)
            || isSuperAdmin());
      // No hard delete from a client: the module soft-deletes (`deletedAt`) so that
      // reports tied to financial/legal records survive. Super-admin only, for GDPR
      // erasure via the tenant-delete job.
      allow delete: if isSuperAdmin();
    }

    // Immutable snapshots. A client reads the version their sign-off refers to, so
    // "approved v3" can always be reproduced exactly as it was approved.
    match /reportVersions/{docId} {
      // A client reads ONLY the `published` snapshots of their own reports — that is
      // the exact artefact their sign-off refers to. `submitted`/`reopened` drafts
      // are internal work in progress.
      allow read: if isBusinessMember(resource.data.businessId)
        || (isPortalClientFor(resource.data.get('customerId', ''))
            && resource.data.get('reason', '') == 'published')
        || isSuperAdmin();
      // A snapshot is signed by whoever took it (useMutation stamps createdByUserId).
      allow create: if canCreateBusinessDoc()
        && (isSuperAdmin() || request.resource.data.get('createdByUserId', '') == request.auth.uid);
      allow update, delete: if isSuperAdmin();
    }

    // Templates: staff-only. They contain the internal block structure (management
    // sections, margin blocks), so a client never reads them.
    match /reportTemplates/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if canManageBusinessDoc() && keepsBusinessId();
      allow delete: if canManageBusinessDoc();
    }

    // Comments. `internal == true` is the leak boundary: the portal query filters on
    // it AND the rule requires it to be false, so a client cannot widen the query to
    // read the team's private discussion of their account.
    match /reportComments/{docId} {
      // `customerId` is denormalised onto the comment (the report's customer), so
      // this is a single clause that matches the portal's narrowed query:
      //   reportId == mine && internal == false
      allow read: if isBusinessMember(resource.data.businessId)
        || (resource.data.internal == false
            && isPortalClientFor(resource.data.get('customerId', '')))
        || isSuperAdmin();
      // A client may comment on their own report, but only as a NON-internal comment
      // authored by themselves — they cannot forge an internal note or another
      // author's identity.
      allow create: if canCreateBusinessDoc()
        || (request.resource.data.internal == false
            && isPortalClientFor(request.resource.data.get('customerId', ''))
            && request.resource.data.get('authorCustomerId', '') == request.resource.data.get('customerId', '')
            && request.resource.data.authorUserId == request.auth.uid
            && isSelfCreate());
      // Only the author edits/resolves their own comment; staff may resolve within
      // the tenant. The `internal` flag is immutable — flipping it after the fact
      // would move a private note into the client's view.
      allow update: if (isAuth() && resource.data.createdByUserId == request.auth.uid
                        && request.resource.data.internal == resource.data.internal)
        || (canManageBusinessDoc() && request.resource.data.internal == resource.data.internal);
      allow delete: if isAuth() && resource.data.createdByUserId == request.auth.uid;
    }

    // Approvals: append-only sign-off record. A client reads their own decisions and
    // the fact that the report was approved internally, never the internal comments
    // attached to those decisions — those live in reportComments.
    match /reportApprovals/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.get('approverCustomerId', ''))
        || isSuperAdmin();
      // A decision is recorded by the person who took it — never on someone's behalf.
      allow create: if canCreateBusinessDoc()
        && (isSuperAdmin() || request.resource.data.get('approverUserId', '') == request.auth.uid);
      // Never mutable: a decision, its timestamp and the version it refers to are
      // evidence (§15/§38.9).
      allow update, delete: if false;
    }

    // The audit / status-history / delivery / view stream. Staff-readable within the
    // tenant; clients never read it (it records who reviewed what internally), and
    // nobody may ever edit it.
    match /reportEvents/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      // Clients DO generate events (view, download, acknowledge) — but those are
      // written server-side by /api/reports with the admin SDK, so no client write
      // path is needed and none is granted. The actor is pinned to the writer: an
      // audit row that names somebody else is not an audit row.
      allow create: if canCreateBusinessDoc()
        && (isSuperAdmin() || request.resource.data.get('actorUserId', '') == request.auth.uid);
      allow update, delete: if false;
    }

    // Automation config, KPI definitions, metric sets, health/accountability
    // rollups — all staff-only management data.
    match /reportSchedules/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if canManageBusinessDoc() && keepsBusinessId();
      allow delete: if canManageBusinessDoc();
    }

    match /reportKpis/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if canManageBusinessDoc() && keepsBusinessId();
      allow delete: if canManageBusinessDoc();
    }

    // Raw metric values, including internal-only ones (margin, hours). Staff only —
    // the client sees metrics through a published report's redacted snapshot.
    //
    // WRITES are admin-only: these rows are produced by the integration jobs
    // (`report-metrics-social`, and the GA4/Ads adapters to come) through the Admin
    // SDK, which bypasses rules entirely. Nothing in the app writes them from a
    // browser, so restricting this costs no functionality and stops a member from
    // hand-editing the numbers a client report is built from.
    match /reportMetrics/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if isBusinessAdmin(request.resource.data.businessId) || isSuperAdmin();
      allow update: if (isBusinessAdmin(resource.data.businessId) || isSuperAdmin()) && keepsBusinessId();
      allow delete: if isBusinessAdmin(resource.data.businessId) || isSuperAdmin();
    }

    // Produced by the `client-health-rollup` job (Admin SDK). The app only READS it,
    // so client-side writes are admin-only — a member must not be able to redraw a
    // client's health score.
    match /clientHealthScores/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if isBusinessAdmin(request.resource.data.businessId) || isSuperAdmin();
      allow update: if (isBusinessAdmin(resource.data.businessId) || isSuperAdmin()) && keepsBusinessId();
      allow delete: if isBusinessAdmin(resource.data.businessId) || isSuperAdmin();
    }

    // Employee accountability data is CONFIDENTIAL EMPLOYEE INFORMATION (§2): a
    // client must never reach it, and it is read within the tenant only.
    //
    // WRITES are admin-only, and this is the case where it matters most: with
    // `canCreateBusinessDoc()` a Member could create or overwrite their OWN
    // accountability score — or a colleague's — from the browser. The rows are
    // produced by the rollup job via the Admin SDK; nothing in the app writes them.
    // Manager feedback, when it gains a UI, must go through an admin-gated path.
    match /employeeReportScores/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if isBusinessAdmin(request.resource.data.businessId) || isSuperAdmin();
      allow update: if (isBusinessAdmin(resource.data.businessId) || isSuperAdmin()) && keepsBusinessId();
      allow delete: if isBusinessAdmin(resource.data.businessId) || isSuperAdmin();
    }

    // ── Phase 4.3a: staff-only collections (never read by the client portal,
    // always businessId-scoped client-side) hardened to server-side tenant RLS.
    // Reads require the requester to belong to the doc's business (or be super-admin).
    // Legacy docs without businessId are simply not returned by the businessId-
    // filtered queries the client issues — no breakage.
    // ── Expenses ────────────────────────────────────────────────────────────
    // Hardened beyond plain membership, because an expense is an accounting
    // record WITH an approval workflow — and the whole workflow used to live in
    // the UI only. With `canManageBusinessDoc()` alone, any member of the
    // business (a Viewer included) could, straight from the browser console:
    //   · set `approvalStatus: 'Approved'` on their own expense;
    //   · edit the amount of an already-approved expense and keep the approval;
    //   · move the row into another tenant by rewriting `businessId`;
    //   · delete someone else's booked cost.
    //
    // `isExpenseApprover` deliberately accepts the membership-document proof as
    // well as the role claim: a token minted before the claims rollout carries
    // no `roles`, and gating on the claim alone would lock a real Admin out of
    // approving anything.
    function isExpenseApprover(businessId, teamId) {
      return isSuperAdmin()
        || isBusinessAdmin(businessId)
        || isTeamAdmin(teamId);
    }
    // Did this edit change WHAT the approval was granted for? Amount, currency and
    // booking date decide HOW MUCH and WHEN; category, project and department
    // decide WHERE it lands — a re-categorised or re-pointed approved cost moves
    // between P&L lines (a Salary row is payroll, a project row is that client's
    // direct cost) without anyone having approved the new placement.
    function expenseValueUnchanged() {
      return request.resource.data.get('amount', 0) == resource.data.get('amount', 0)
        && request.resource.data.get('currency', 'ALL') == resource.data.get('currency', 'ALL')
        && request.resource.data.get('date', null) == resource.data.get('date', null)
        && request.resource.data.get('category', null) == resource.data.get('category', null)
        && request.resource.data.get('projectId', null) == resource.data.get('projectId', null)
        && request.resource.data.get('departmentId', null) == resource.data.get('departmentId', null);
    }
    // `category: 'Salary'` rows ARE the payroll (src/lib/finance/payroll.ts costs
    // a month from them and every expense-row total filters them out), so a
    // Member who could book one would move every P&L, the cost/hour of every
    // colleague and the cash-flow forecast. Approvers only — on the way in AND
    // for any edit of a row that is, or becomes, a salary row.
    function expenseTouchesSalary() {
      return request.resource.data.get('category', '') == 'Salary'
        || (resource != null && resource.data.get('category', '') == 'Salary');
    }
    function expenseApprovalUnchanged() {
      return request.resource.data.get('approvalStatus', '') == resource.data.get('approvalStatus', '');
    }
    // Booking MONTH of an expense, for the month-close lock (monthLockedFor).
    // `expense.date` is a Timestamp (getExpenseDate() = date || createdAt) and
    // the books are kept in Europe/Tirane, but rules only do UTC calendar math —
    // so the instant is shifted by +2 h (Tirane's MAX offset, CEST) before the
    // month is read. Every date the app writes is a day at 00:00 UTC
    // (`new Date('YYYY-MM-DD')`) or local midnight (22:00/23:00 UTC the day
    // before), and both land in the right month that way. The one
    // approximation: a real instant between 22:00 and 22:59 UTC on the last day
    // of a WINTER month (23:xx local) is read as the next month. A legacy
    // string date uses its own 'YYYY-MM'.
    function tsMonthKey(t) {
      return string(t.year()) + '-' + (t.month() < 10 ? '0' + string(t.month()) : string(t.month()));
    }
    function expenseMonthKey(data) {
      let d = data.get('date', null) != null ? data.get('date', null) : data.get('createdAt', null);
      return d is timestamp ? tsMonthKey(d + duration.value(2, 'h'))
        : (d is string && d.matches('^[0-9]{4}-[0-9]{2}.*') ? d[0:7] : '');
    }
    // Did this edit change what the closed month's books say about the row —
    // how much, when, where, and whether it counts (the approval verdict)?
    // Status / paid flag / notes / attachments / a recurring PARENT's series
    // pointers are not booking facts, so they stay editable in a closed month
    // (a bill booked in a closed month is still paid later; a series whose
    // parent row is old is still paused / resumed / backfilled forward).
    function expenseBookingUnchanged() {
      return expenseValueUnchanged() && expenseApprovalUnchanged();
    }
    function expenseMonthOpen(businessId, data) {
      return !monthLockedFor(businessId, expenseMonthKey(data));
    }
    match /expenses/{docId} {
      // Salary rows (`category: 'Salary'`) ARE the payroll — every colleague's pay.
      // Only an approver (Admin/Manager) reads them, plus the person the row
      // pays (`memberId`). A non-approver's LIST must therefore carry
      // `where('category', '!=', 'Salary')` (or `where('memberId', '==', uid)`)
      // so the rule is provable from the query; an unconstrained list is denied.
      //
      // NOT `resource.data.get('category', '') != 'Salary'`: when a list query
      // does not constrain the field, the rules engine evaluates `.get()` with
      // its DEFAULT — '' != 'Salary' is then "proven" and the bare list (salaries
      // included) is ALLOWED (verified in the emulator). Direct field access is
      // unprovable for an unconstrained field and denies, as it must. A row with
      // no `category` is therefore an approver's read; the form always writes one.
      allow read: if (isBusinessMember(resource.data.businessId)
          && (('category' in resource.data && resource.data.category != 'Salary')
              || resource.data.memberId == request.auth.uid
              || isExpenseApprover(resource.data.businessId, resource.data.get('teamId', ''))))
        || isSuperAdmin();

      // A non-approver may only submit; self-approving on the way in is refused.
      // `teamId` names the department whose Admin/Manager may approve
      // (isTeamAdmin), so it must be a department OF this business — otherwise a
      // member could route their expense to a team they administer elsewhere.
      allow create: if canCreateBusinessDoc() && !isViewerRole()
        && (request.resource.data.get('teamId', '') == ''
            || businessOfTeam(request.resource.data.get('teamId', '')) == request.resource.data.businessId)
        && (isExpenseApprover(request.resource.data.businessId, request.resource.data.get('teamId', ''))
            || (request.resource.data.get('approvalStatus', 'Submitted') == 'Submitted'
                && request.resource.data.get('category', '') != 'Salary'))
        // Nothing is booked INTO a closed month (financeMonthCloses lock).
        && expenseMonthOpen(request.resource.data.businessId, request.resource.data);

      allow update: if canManageBusinessDoc() && !isViewerRole()
        // The tenant key is immutable — no moving a cost into another business.
        && keepsBusinessId()
        // A closed month's booking facts are frozen — for the row's OLD month
        // and the month it would move to (see expenseBookingUnchanged).
        && (expenseBookingUnchanged()
            || (expenseMonthOpen(resource.data.businessId, resource.data)
                && expenseMonthOpen(resource.data.businessId, request.resource.data)))
        && (
          isExpenseApprover(resource.data.businessId, resource.data.get('teamId', ''))
          // A non-approver edits only rows they submitted themselves — never a
          // colleague's cost (and never hands their own row to someone else) …
          || (resource.data.get('createdByUserId', '') == request.auth.uid
              && request.resource.data.get('createdByUserId', '') == request.auth.uid
          // … never touches payroll (see expenseTouchesSalary) …
              && !expenseTouchesSalary()
              // … may never re-route the row to another department (the approver
              // set is derived from `teamId`) …
              && request.resource.data.get('teamId', '') == resource.data.get('teamId', '')
              && (
                // … may edit freely as long as the verdict and the thing it was
                // granted for both stay put …
                (expenseApprovalUnchanged() && expenseValueUnchanged())
                // … or may change amount/currency/date/category/project/department,
                // but ONLY by sending the row back for approval. This is the guard
                // that stops an approved 1 000 from becoming 100 000 — or a "Rent"
                // row from becoming a project's direct cost — while still reading
                // "Aprovuar".
                || request.resource.data.get('approvalStatus', '') == 'Submitted'
              ))
        );

      // A booked, approved cost is not a member's to delete; nothing booked in
      // a closed month is anyone's to delete.
      allow delete: if canManageBusinessDoc() && !isViewerRole()
        && expenseMonthOpen(resource.data.businessId, resource.data)
        && (isExpenseApprover(resource.data.businessId, resource.data.get('teamId', ''))
            || (resource.data.get('createdByUserId', '') == request.auth.uid
                && resource.data.get('approvalStatus', '') != 'Approved'));
    }

    match /goals/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc() && !isViewerRole();
      allow update: if canManageBusinessDoc() && keepsBusinessId() && !isViewerRole();
      allow delete: if canManageBusinessDoc() && !isViewerRole();
    }

    // Logged hours — the base of every cost figure in Financat. A person writes
    // their OWN hours (an admin/manager anyone's), and nothing dated inside a CLOSED
    // month (`financeMonthCloses/{businessId}_{YYYY-MM}` with locked: true) can be
    // created, edited or deleted any more: the month's client table was signed off
    // on those hours. `date` is the local YYYY-MM-DD day (src/lib/finance/timeEntries.ts).
    function monthLockedFor(bid, day) {
      return day is string && day.size() >= 7
        && exists(/databases/$(database)/documents/financeMonthCloses/$(bid + '_' + day[0:7]))
        && get(/databases/$(database)/documents/financeMonthCloses/$(bid + '_' + day[0:7])).data.get('locked', false) == true;
    }
    // `date` MUST be a well-formed YYYY-MM-DD on every write: the month lock keys
    // on `date[0:7]`, so a row with no date (or a Date object, or "15/01/2026")
    // slipped past a closed month — it simply never matched the lock's id.
    function timeEntryDateOk() {
      return request.resource.data.get('date', '') is string
        // A real month (01-12) and day (01-31). Rules cannot know that September
        // has 30 days; src/lib/finance/timeEntries.ts (isValidDayKey) treats a
        // key that does not round-trip ("2026-09-31") as no date at all.
        && request.resource.data.date.matches('^[0-9]{4}-(0[1-9]|1[0-2])-(0[1-9]|[12][0-9]|3[01])$');
    }
    match /timeEntries/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc()
        && timeEntryDateOk()
        && (isSuperAdmin()
            || request.resource.data.get('userId', '') == request.auth.uid
            || isBusinessAdmin(request.resource.data.businessId))
        && !monthLockedFor(request.resource.data.businessId, request.resource.data.get('date', ''));
      allow update: if canManageBusinessDoc()
        && keepsBusinessId()
        && timeEntryDateOk()
        && (isSuperAdmin()
            || isBusinessAdmin(resource.data.businessId)
            // Own row: edit it, but never hand it to somebody else.
            || (resource.data.get('userId', '') == request.auth.uid
                && request.resource.data.get('userId', '') == request.auth.uid))
        && !monthLockedFor(resource.data.businessId, resource.data.get('date', ''))
        && !monthLockedFor(resource.data.businessId, request.resource.data.get('date', ''));
      allow delete: if canManageBusinessDoc()
        && (isSuperAdmin()
            || resource.data.get('userId', '') == request.auth.uid
            || isBusinessAdmin(resource.data.businessId))
        && !monthLockedFor(resource.data.businessId, resource.data.get('date', ''));
    }

    // The month close: written by an OWNER/ADMIN of the business only (not a
    // Manager — closing the books is a company-level sign-off, and the lock
    // freezes every colleague's hours), at the id the lock rule above looks up;
    // never deleted (re-opening is an update with locked: false + reopenedAt by
    // the same caller set, so the audit trail survives). A suspended tenant
    // neither closes nor re-opens a month.
    match /financeMonthCloses/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if (isSuperAdmin() || isBusinessOwnerOrAdmin(request.resource.data.businessId))
        && tenantActive(request.resource.data.businessId)
        && docId == request.resource.data.businessId + '_' + request.resource.data.get('periodKey', '');
      allow update: if (isSuperAdmin() || isBusinessOwnerOrAdmin(resource.data.businessId))
        && tenantActive(resource.data.businessId)
        && keepsBusinessId()
        && request.resource.data.get('periodKey', '') == resource.data.get('periodKey', '');
      allow delete: if false;
    }

    // Private part of a month close: the client-table SNAPSHOT (per-client and
    // per-person cost lines) moved out of the parent, which every member of the
    // business reads. Readable and writable ONLY by the audience that writes the
    // close itself (owner/Admin, never a Manager or Member). Authorised on the
    // subdoc's OWN data, not a get() on the parent: the first close writes the
    // parent and this doc in ONE batch, and a get() would not see the parent yet.
    // The id binding is the same as the parent's (`{businessId}_{periodKey}`),
    // and an update can never move it to another business or month. Never deleted.
    match /financeMonthCloses/{closeId}/private/{docId} {
      allow read: if isSuperAdmin() || isBusinessOwnerOrAdmin(resource.data.businessId);
      allow create: if (isSuperAdmin() || isBusinessOwnerOrAdmin(request.resource.data.businessId))
        && tenantActive(request.resource.data.businessId)
        && closeId == request.resource.data.businessId + '_' + request.resource.data.get('periodKey', '');
      allow update: if (isSuperAdmin() || isBusinessOwnerOrAdmin(resource.data.businessId))
        && tenantActive(resource.data.businessId)
        && keepsBusinessId()
        && request.resource.data.get('periodKey', '') == resource.data.get('periodKey', '')
        && closeId == request.resource.data.businessId + '_' + request.resource.data.get('periodKey', '');
      allow delete: if false;
    }

    // Monthly report idempotency (cron-written).
    match /financeReportRuns/{docId} {
      allow read: if isBusinessAdmin(resource.data.businessId) || isSuperAdmin();
      allow write: if false;
    }

    // Server-owned project rollup fields (see the projects rule below).
    function projectRollupKeys() {
      return ['spent', 'laborCost', 'hoursByRole', 'spendRolledUpAt', 'budgetAlertsSent',
              // The WORK cycle's idempotency token + diagnosis (recurring-project-reset):
              // a browser that moved the claim could skip or re-run a month's cycle.
              'workCycleLastPeriodKey', 'workCycleLastBlock', 'workCycleCheckedAt', 'workCycleCarriedOver',
              // The reset's two-phase claim (period claimed → tasks applied) + its
              // "opening from" pointer: browser-written, a cycle could be re-run or skipped.
              'workCycleTasksAppliedKey', 'workCycleOpeningFromKey', 'workCycleClaimedAt',
              // Renewal-notice debounce for quarterly / yearly retainers (Part 2).
              'renewalNoticePeriodKey'];
    }

    // ── Project MONEY fields (audit Oct 2026) ──
    // The recurring-billing cron (api/cron/run.ts, Part 2) bills `budget` in
    // `currency` on the project's cycle and emails the client the project's
    // `bank*` details; the plan fields drive the EAC, earned revenue and the
    // department split. Any non-Viewer could rewrite all of them from the
    // browser console — re-price a retainer, switch billing on, or redirect the
    // client's payment to another IBAN. They are now Admin/Manager (the
    // `canSeeBudget` = canSeeFinancials audience: isAdmin || isManager; owner
    // and super-admin included) via the signed `roles` claim (isBusinessAdmin).
    //
    // `customerId` and `serviceIds` stay writable: ProjectsView re-assigns a
    // project's client, and a Member picks the services of a project they run
    // (neither moves an amount — the fee is `budget`, the split is `serviceMix`).
    //
    // A Member may still do what the UI lets every editor do, all in the SAFE
    // direction: archive / stop a retainer (isRecurring true → false, setting
    // the `wasRecurringBeforeArchive` token), pause it, restore a series that
    // was running before it was archived/cancelled (consuming the token), and
    // write the FIRST period claim right after creating a recurring project.
    // Resuming a PAUSED series, re-pricing, re-scheduling and the plan are not.
    function projectBankKeys() {
      return ['paymentMethod', 'bankName', 'bankIBAN', 'bankSWIFT', 'bankAccountHolder', 'bankCountry'];
    }
    function projectPlanKeys() {
      return ['serviceMix', 'plannedRoles', 'plannedHours', 'plannedLaborCost', 'plannedDirectExpenses',
              'targetMarginPct', 'recognitionMethod', 'remainingHoursEstimate'];
    }
    function projectFinanceKeys() {
      return projectBankKeys().concat(projectPlanKeys()).concat([
        'budget', 'currency', 'isRecurring', 'isRecurringPaused', 'recurringFrequency',
        'recurringEndDate', 'billingType', 'billingDayOfMonth', 'lastInvoicePeriodKey',
        'wasRecurringBeforeArchive',
        // Quarterly / yearly cycles: the contract-year anchor, payment terms and
        // the monthly list price + prepay discount the cycle fee came from.
        'billingAnchorAt', 'invoiceDueDays', 'listMonthlyFee', 'prepayDiscountPct']);
    }
    function projectFinanceManager(businessId) {
      return isSuperAdmin() || isBusinessAdmin(businessId);
    }
    // "Nothing" in every shape the write layer produces for an empty form field
    // (null, '', 0, false, [], {}) — the edit form writes `billingDayOfMonth:
    // null`, `plannedRoles: []`, `isRecurring: false` onto projects that never
    // had the key, and that must not read as a money change.
    function isEmptyValue(v) {
      return v == null || v == '' || v == 0 || v == false || v == [] || v == {};
    }
    function projKeySame(k) {
      return request.resource.data.get(k, null) == resource.data.get(k, null)
        || (isEmptyValue(resource.data.get(k, null)) && isEmptyValue(request.resource.data.get(k, null)));
    }
    function projMoneyUnchanged() {
      return projKeySame('budget')
        && request.resource.data.get('currency', 'ALL') == resource.data.get('currency', 'ALL')
        && request.resource.data.get('recurringFrequency', 'monthly') == resource.data.get('recurringFrequency', 'monthly')
        // billingType absent = inferred from isRecurring (the form's own default).
        && request.resource.data.get('billingType', 'x') == resource.data.get('billingType',
             resource.data.get('isRecurring', false) == true ? 'monthly' : 'one-time')
        && projKeySame('billingDayOfMonth')
        // Long-cycle inputs: one key-set check, not four projKeySame() calls — those
        // pushed a Member's full edit form over the 1000-expression limit (81a). The
        // Member form never sends these keys, so "untouched" is the only shape needed.
        && !request.resource.data.diff(resource.data).affectedKeys()
              .hasAny(['billingAnchorAt', 'invoiceDueDays', 'listMonthlyFee', 'prepayDiscountPct'])
        && projKeySame('paymentMethod') && projKeySame('bankName') && projKeySame('bankIBAN')
        && projKeySame('bankSWIFT') && projKeySame('bankAccountHolder') && projKeySame('bankCountry')
        && projKeySame('serviceMix') && projKeySame('plannedRoles') && projKeySame('plannedHours')
        && projKeySame('plannedLaborCost') && projKeySame('plannedDirectExpenses')
        && projKeySame('targetMarginPct') && projKeySame('recognitionMethod')
        && projKeySame('remainingHoursEstimate');
    }
    function projBillingTransitionOk() {
      let oldRec = resource.data.get('isRecurring', false) == true;
      let newRec = request.resource.data.get('isRecurring', false) == true;
      // The restore token may always be CONSUMED (→ false); only a stop may set it.
      let tokenKeptOrDropped = projKeySame('wasRecurringBeforeArchive')
        || request.resource.data.get('wasRecurringBeforeArchive', false) == false;
      return (oldRec == newRec
              && tokenKeptOrDropped
              && projKeySame('recurringEndDate')
              // pause yes, resume-from-pause no
              && (projKeySame('isRecurringPaused') || request.resource.data.get('isRecurringPaused', false) == true)
              // the first claim (ProjectsView, right after create) or none
              && (projKeySame('lastInvoicePeriodKey') || isEmptyValue(resource.data.get('lastInvoicePeriodKey', null))))
        // STOP / ARCHIVE (archiveProjectPatch, stopProjectBillingPatch)
        || (oldRec && !newRec
            && (tokenKeptOrDropped || request.resource.data.get('wasRecurringBeforeArchive', false) == true)
            && (projKeySame('recurringEndDate') || request.resource.data.get('recurringEndDate', null) == null)
            && (projKeySame('isRecurringPaused') || request.resource.data.get('isRecurringPaused', false) == false)
            && projKeySame('lastInvoicePeriodKey'))
        // RESUME a series that was running before an archive/cancel
        // (resumeRecurringBillingPatch): the token must be there and consumed;
        // the claim re-point it carries is free (the occurrence id is
        // deterministic, so moving it can never produce a second invoice).
        || (!oldRec && newRec
            && resource.data.get('wasRecurringBeforeArchive', false) == true
            && request.resource.data.get('wasRecurringBeforeArchive', true) == false
            && projKeySame('recurringEndDate')
            && projKeySame('isRecurringPaused'));
    }
    // CREATE by a Member: the form computes `budget` from the picked services
    // and may make the project recurring, but bank details, an explicit service
    // split and the staffing plan (cost rates) are Admin/Manager input.
    function projCreateKeyEmpty(k) {
      return isEmptyValue(request.resource.data.get(k, null));
    }
    function projCreateFinanceOk() {
      return projectFinanceManager(request.resource.data.businessId)
        || (projCreateKeyEmpty('paymentMethod') && projCreateKeyEmpty('bankName') && projCreateKeyEmpty('bankIBAN')
            && projCreateKeyEmpty('bankSWIFT') && projCreateKeyEmpty('bankAccountHolder') && projCreateKeyEmpty('bankCountry')
            && projCreateKeyEmpty('serviceMix') && projCreateKeyEmpty('plannedRoles') && projCreateKeyEmpty('plannedHours')
            && projCreateKeyEmpty('plannedLaborCost') && projCreateKeyEmpty('plannedDirectExpenses')
            && projCreateKeyEmpty('targetMarginPct') && projCreateKeyEmpty('remainingHoursEstimate')
            && projCreateKeyEmpty('wasRecurringBeforeArchive'));
    }
    match /projects/{docId} {
      // Portal clients reach projects either as the customer OR as an explicit
      // project member (memberUserIds) — PortalProjectsView issues both queries.
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || (isAuth() && resource.data.memberUserIds is list
            && request.auth.uid in resource.data.memberUserIds)
        || isSuperAdmin();
      // The rollup fields are SERVER-OWNED: `project-spend-rollup` (Admin SDK)
      // derives `spent` / `laborCost` / `hoursByRole` / `spendRolledUpAt` /
      // `budgetAlertsSent` from expenses + timeEntries. A browser that could set
      // them would fake a project's burn-down and silence (or re-fire) the
      // 70/85/100 % budget alarms. Create may carry `spent: 0` (ProjectsView's
      // shape) and nothing else; update may spread them UNCHANGED only.
      allow create: if canCreateBusinessDoc() && !isViewerRole()
        && !request.resource.data.keys().hasAny(['laborCost', 'hoursByRole', 'spendRolledUpAt', 'budgetAlertsSent',
                                                  'workCycleLastPeriodKey', 'workCycleLastBlock', 'workCycleCheckedAt', 'workCycleCarriedOver',
                                                  'workCycleTasksAppliedKey', 'workCycleOpeningFromKey', 'workCycleClaimedAt'])
        && request.resource.data.get('spent', 0) == 0
        && projCreateFinanceOk();
      // STAFF ONLY. No portal view writes `projects` (PortalProjectsView /
      // PortalProjectDetailView only read), and the old `|| isPortalClientFor(...)`
      // let a client rename, re-budget, archive or DELETE the project — and the
      // tasks/invoices cascade behind it — from the browser console.
      // `customerId` stays writable: ProjectsView re-assigns a project's client.
      allow update: if canManageBusinessDoc() && keepsBusinessId() && !isViewerRole()
        && (isSuperAdmin()
            || !request.resource.data.diff(resource.data).affectedKeys()
                .hasAny(projectRollupKeys()))
        // Money fields: Admin/Manager, or a Member edit that leaves them as they
        // are / moves billing in the SAFE direction (see projectFinanceKeys).
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(projectFinanceKeys())
            || projectFinanceManager(resource.data.businessId)
            || (projMoneyUnchanged() && projBillingTransitionOk()));
      allow delete: if canManageBusinessDoc() && !isViewerRole();
    }

    match /channels/{docId} {
      // WAS fully open to any signed-in user (channel names/topics of every tenant).
      // Now tenant-scoped: `businessId` is stamped on create and backfilled by the
      // `backfill-tenant-keys` job, and ChatView reads channels business-scoped.
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      // A group is born with its creator as member AND admin — otherwise nobody
      // could ever manage it under the admin-only update rule below.
      // Only AUTO-ID docs (20 chars, what addDoc mints): a hand-chosen id could
      // re-create a LEGACY fixed-channel id (`general`, …) and "prove" membership
      // over messages other tenants wrote under that id via isGroupChannelMember.
      allow create: if canCreateBusinessDoc()
        && (isSuperAdmin() || docId.size() == 20)
        && (
        request.resource.data.get('isGroup', false) != true
        || (request.resource.data.get('admins', []).hasAny([request.auth.uid])
            && request.resource.data.get('members', []).hasAny([request.auth.uid]))
      );
      // Group management was enforced ONLY in the UI: any business member could add
      // themselves to a private group, drop its admins, rename or delete it.
      //   - an admin (or the creator) edits anything;
      //   - a member may write the last-message denormalisation on send;
      //   - a member may LEAVE (write members/admins only, and only to a list that no
      //     longer contains them);
      //   - a non-group (legacy fixed channel) keeps the business-member rule.
      allow update: if keepsBusinessId() && (
        resource.data.get('isGroup', false) != true
          ? canManageBusinessDoc()
          : (
            isGroupAdmin()
            || (isGroupMemberOf(resource)
                && request.resource.data.diff(resource.data).affectedKeys()
                  .hasOnly(['lastMessageAt', 'lastMessagePreview', 'lastMessageSenderId', 'updatedAt']))
            // LEAVE = the old lists minus exactly yourself. "New lists must not
            // contain me" alone let a departing member write `members: []` and
            // kick the whole roster (admins included) in one update.
            || (isGroupMemberOf(resource)
                && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'admins', 'updatedAt'])
                && request.resource.data.get('members', []) == resource.data.get('members', []).removeAll([request.auth.uid])
                && request.resource.data.get('admins', []) == resource.data.get('admins', []).removeAll([request.auth.uid]))
            || isSuperAdmin()
          )
      );
      allow delete: if resource.data.get('isGroup', false) != true
        ? canManageBusinessDoc()
        : (isGroupAdmin() || isSuperAdmin());
    }


    // Denormalised 1:1 thread heads (WhatsApp-style list previews): one doc per pair,
    // id = the two uids sorted and joined with '__'. Written by the sender on every DM
    // (and by the chat-scheduled cron). Readable only by the two participants.
    // The OTHER participant must be a user of my own tenant — same law as the DM
    // itself; a thread head pointing at a stranger would put my name in their list.
    match /dmThreads/{docId} {
      allow read: if isAuth() && resource.data.get('participants', []).hasAny([request.auth.uid]);
      allow create: if isAuth()
        && request.resource.data.get('participants', []).hasAny([request.auth.uid])
        && request.resource.data.get('participants', []).size() == 2
        && (isSuperAdmin()
            || isUserInMyTenant(
                 request.resource.data.participants[0] == request.auth.uid
                   ? request.resource.data.participants[1]
                   : request.resource.data.participants[0]))
        && (!(request.resource.data.get('businessId', '') is string)
            || request.resource.data.get('businessId', '') == ''
            || isBusinessMember(request.resource.data.businessId));
      // Only the denormalised preview may change; the tenant key may be filled in
      // but never re-pointed; and a participant may not put the OTHER participant's
      // name on a preview THEY wrote (impersonation in the recipient's list).
      allow update: if isAuth()
        && resource.data.get('participants', []).hasAny([request.auth.uid])
        && request.resource.data.get('participants', []) == resource.data.get('participants', [])
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['lastMessage', 'updatedAt', 'businessId', 'participants'])
        && (!(resource.data.get('businessId', '') is string)
            || resource.data.get('businessId', '') == ''
            || request.resource.data.get('businessId', '') == resource.data.get('businessId', ''))
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastMessage'])
            || request.resource.data.get('lastMessage', {}).get('senderId', '') == request.auth.uid);
      allow delete: if false;
    }

    // Persistent client conversation threads (Request 1: owner + watchers routing).
    // The doc id IS the channelId. Access = you're a watcher, OR you can reach the
    // underlying client channel (portal client / business member), OR super-admin.
    // watchers always includes the manager + all admins (even when unassigned), so
    // the single `watchers array-contains uid` staff query is provably authorized.
    match /conversations/{convId} {
      allow read: if isAuth() && (
        request.auth.uid in resource.data.watchers
        || canAccessClientChannel(convId)
        || isBusinessMember(resource.data.businessId)
        || isSuperAdmin()
      );
      // Portal client opens their own thread; staff create within their business.
      // The `businessId == null` escape hatch is gone: an untagged conversation is
      // invisible to the tenant-scoped staff queries anyway, and it let any signed-in
      // user create arbitrary threads.
      // A thread's businessId, when stamped, must be a tenant the creator belongs to
      // (staff) or is a client of — never somebody else's.
      allow create: if isAuth() && (
        (canAccessClientChannel(convId)
          && (!(request.resource.data.get('businessId', '') is string)
              || request.resource.data.get('businessId', '') == ''
              || isBusinessMember(request.resource.data.businessId)
              || isPortalClientOfBusiness(request.resource.data.businessId)))
        || isBusinessMember(request.resource.data.businessId)
      );
      // Owner/manager/admin (business member, or a watcher) update it inside the
      // tenant (never re-pointing businessId). The PORTAL CLIENT's only write is the
      // activity bump on their own thread — never the owner, watchers, SLA state or
      // linkage (PortalChatView routes everything else through /api/notify-staff).
      allow update: if isAuth() && (
        ((request.auth.uid in resource.data.watchers
            || isBusinessMember(resource.data.businessId))
          && keepsBusinessId()
          && conversationAgentUntouched())
        || (canAccessClientChannel(convId)
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['lastMessageAt', 'lastMessagePreview', 'lastClientMessageAt', 'lastInboundAt', 'awaitingReply', 'updatedAt']))
        || isSuperAdmin()
      );
      allow delete: if isAuth() && (isBusinessMember(resource.data.businessId) || isSuperAdmin());
    }

    match /messages/{docId} {
      // Was `if isAuth()` — every DM and channel message readable cross-tenant.
      // Now: business members read their tenant's messages; a user always reads
      // their own DMs (sender/receiver); a portal client reads their own client
      // channel; staff reach legacy client-channel messages via canAccessClientChannel.
      // Sweep queries (Sidebar/MobileBottomNav unread-client, ChatView recent-client)
      // were de-scoped to businessId so they no longer span tenants.
      allow read: if isBusinessMember(resource.data.businessId)
        || resource.data.senderId == request.auth.uid
        || resource.data.receiverId == request.auth.uid
        || canAccessClientChannel(resource.data.channelId)
        || isGroupChannelMember(resource.data.channelId)
        || isSuperAdmin();
      // HARDENED create — every message is sent AS YOURSELF (`senderId` == uid, and
      // `createdByUserId` when useMutation stamps it):
      //   • a PORTAL CLIENT (`senderType: 'client'`) posts only into their OWN client
      //     channel (PortalChatView);
      //   • STAFF post inside their own BUSINESS (useMutation stamps businessId):
      //       – a DM's `receiverId` must be a user of that tenant (a DM to a
      //         stranger's uid was accepted before — cross-tenant spam/phishing),
      //       – a `client-<cid>` channel must be one they can reach (the customer
      //         must be theirs — a foreign staff message in a client's thread was
      //         readable by that client),
      //       – a GROUP channel accepts posts from its MEMBERS only.
      //   The old `isTeamMember(teamId)`-only branch is gone: a teamId names no
      //   tenant, and a caller could stamp any businessId next to a team they were in.
      allow create: if isAuth()
        && request.resource.data.get('senderId', '') == request.auth.uid
        && request.resource.data.get('createdByUserId', request.auth.uid) == request.auth.uid
        && (
          // `senderType: 'client'` is the PORTAL CLIENT'S identity on a row (it is
          // what the staff unread sweeps, the "client_message" notification and
          // the ✓✓ receipt key on) — so it is accepted only from the customer the
          // channel is named for (`client-<cid>[-project-<id>]`, PortalChatView),
          // proven by the `cid` claim / users.customerId. canAccessClientChannel
          // also admits STAFF of the customer's business, which let a staff user
          // post as the client (test 84h).
          (request.resource.data.get('senderType', '') == 'client'
            && isClientChannelId(request.resource.data.get('channelId', ''))
            // (`client--x` would split to '' and match a staff token's empty cid)
            && request.resource.data.channelId.split('-')[1] != ''
            && isPortalClientDoc(request.resource.data.channelId.split('-')[1])
            // The stamped tenant, when present, must be the client's own — a foreign
            // businessId landed the row in ANOTHER tenant's unread sweeps and GDPR export.
            && (!(request.resource.data.get('businessId', '') is string)
                || request.resource.data.get('businessId', '') == ''
                || isPortalClientOfBusiness(request.resource.data.businessId)))
          // Staff rows carry no senderType (DMs, groups, task chat) or 'staff'
          // (ChatView in a client thread) — nothing else.
          || (request.resource.data.get('senderType', '') in ['', 'staff']
              && (isSuperAdmin() || canCreateBusinessDoc())
              && (!(request.resource.data.get('receiverId', '') is string)
                  || request.resource.data.get('receiverId', '') == ''
                  || isUserInMyTenant(request.resource.data.receiverId)
                  || isSuperAdmin())
              && (!isClientChannelId(request.resource.data.get('channelId', ''))
                  || canWriteClientChannel(request.resource.data.channelId))
              // Client threads, DMs (no channelId) and legacy fixed channels (no
              // `channels` doc) are unaffected by the group check.
              && (
                !(request.resource.data.get('channelId', '') is string)
                || request.resource.data.get('channelId', '') == ''
                || !exists(/databases/$(database)/documents/channels/$(request.resource.data.channelId))
                || get(/databases/$(database)/documents/channels/$(request.resource.data.channelId)).data.get('isGroup', false) != true
                || isGroupChannelMember(request.resource.data.channelId)
                || isSuperAdmin()
              ))
        );
      // The SENDER edits / soft-deletes / pins their own message — content-ish keys
      // only (ChatView's edit, delete, pin, reaction and mark-read writes). They may
      // not re-point it (senderId / receiverId / channelId / businessId / teamId) —
      // a message written into my own DM and then re-aimed at another tenant's
      // channel would have carried my tenant's stamp into theirs.
      // Collaborative actions (read/reactions/pin) are allowed ONLY to someone who
      // can already access the message — the same tenant/participant/channel test
      // as `read`. Was unconditional, letting any signed-in user mutate any message
      // cross-tenant by doc id.
      // `readAt`/`readBy` are OUT of the sender's whitelist: `readAt` is the
      // reader's "✓✓ Parë" receipt and `readBy` the group members' read set — a
      // sender stamping either on their own message forges a receipt. `isRead`
      // stays: the soft delete writes it so a deleted row leaves the unread window.
      allow update: if isAuth() && (
        (resource.data.senderId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
               'content', 'editedAt', 'editHistory', 'isDeleted', 'deletedAt', 'attachmentUrl',
               'attachmentName', 'attachmentType', 'mentions', 'reactions', 'isPinned', 'pinnedAt',
               'pinnedBy', 'isRead', 'updatedAt']))
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['isRead', 'readAt', 'readBy', 'updatedAt', 'reactions', 'isPinned', 'pinnedAt', 'pinnedBy'])
          // A DM's collaborative writes belong to its RECEIVER alone. Any business
          // member could otherwise flip `isRead` on a colleague's DMs from the
          // console — silently killing their unread badge and the mark pass.
          && (resource.data.get('channelId', '') != ''
              || !(resource.data.get('receiverId', '') is string)
              || resource.data.get('receiverId', '') == ''
              || resource.data.receiverId == request.auth.uid
              || isSuperAdmin())
          // `readAt` is the "Parë" receipt: writable on a CLIENT's own row (the
          // staff read receipt) or by the portal client themselves on a staff row
          // — never stamped onto a staff→client row by other staff (forgery the
          // UI alone used to prevent).
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['readAt'])
              || resource.data.get('senderType', '') == 'client'
              || (isClientChannelId(resource.data.get('channelId', ''))
                  && isPortalClientDoc(resource.data.get('channelId', '').split('-')[1]))
              || isSuperAdmin())
          // `readBy` (group read set): the writer must be a member of the channel
          // the row claims, AND a `channels` doc minted over a foreign/legacy
          // channelId must not grant writes on another tenant's rows — the channel
          // doc's tenant has to match the message's (when the message carries one).
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['readBy'])
              || (isGroupChannelMember(resource.data.get('channelId', ''))
                  && (resource.data.get('businessId', '') == ''
                      || get(/databases/$(database)/documents/channels/$(resource.data.channelId)).data.get('businessId', '') == resource.data.get('businessId', '')))
              || isSuperAdmin())
          && (
            isBusinessMember(resource.data.businessId)
            || resource.data.receiverId == request.auth.uid
            || canAccessClientChannel(resource.data.channelId)
            || isGroupChannelMember(resource.data.channelId)
            || isSuperAdmin()
          )
        )
      );
      // The SENDER deletes their own message — and, for a TASK CHAT row (`taskId`),
      // the staff deleting that task (src/lib/deleteCascade.ts, Phase 2: the
      // messages go BEFORE the task doc, so the task is still there to bind to):
      // a non-Viewer member of the business, on a row whose task is of that
      // business — the same people the tasks rule lets delete the task (test 84n).
      allow delete: if isAuth() && (
        resource.data.senderId == request.auth.uid
        || (canManageBusinessDoc() && !isViewerRole()
            && taskInBusiness(resource.data.get('taskId', ''), resource.data.businessId))
      );
    }

    // The CRM timeline. A row is logged AS YOURSELF (`userId` — useActivityLogger,
    // useFollowUpActions and Customer360View all stamp user.uid) and never by a
    // Viewer, who has no action to log; a colleague could otherwise forge "X called
    // the client" rows under someone else's name (test 84d).
    match /activities/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc() && !isViewerRole()
        && (isSuperAdmin() || request.resource.data.get('userId', '') == request.auth.uid);
      allow update, delete: if false;
    }

    // The daily staff report is filed by its author (`userId`); a manager/admin may
    // annotate it (blocker resolved, feedback). A colleague may not rewrite or erase
    // someone else's report — it is the evidence the accountability rollup reads.
    match /dailyReports/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc()
        && (isSuperAdmin()
            || request.resource.data.get('userId', '') == request.auth.uid
            || isBusinessAdmin(request.resource.data.businessId));
      allow update: if canManageBusinessDoc() && keepsBusinessId()
        && (isSuperAdmin()
            || resource.data.get('userId', '') == request.auth.uid
            || isBusinessAdmin(resource.data.businessId))
        && request.resource.data.get('userId', '') == resource.data.get('userId', '');
      allow delete: if canManageBusinessDoc()
        && (isSuperAdmin()
            || resource.data.get('userId', '') == request.auth.uid
            || isBusinessAdmin(resource.data.businessId));
    }

    // Who did NOT report, per tenant per day. Written ONLY by the daily-report-check
    // cron (Admin SDK, which bypasses these rules) — a client that could write here
    // could erase its own absence, which is the one record the escalation depends on.
    match /dailyReportMisses/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow write: if false;
    }

    match /invoiceItems/{docId} {
      // Staff via businessId; portal client via customerId (derived from invoice).
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isSuperAdmin();
      // The lines of a SETTLED invoice (Paid / Partial / Cancelled) are frozen
      // for a Member exactly like its amounts (invoiceAmountsAllowed), and a line
      // can never be moved to another invoice or tenant.
      allow create: if canCreateBusinessDoc() && !isViewerRole()
        && invoiceItemWriteAllowed(request.resource.data.get('invoiceId', ''), request.resource.data.businessId);
      // STAFF ONLY — the same hole that was closed on /invoices was left open here:
      // `isPortalClientFor(...)` let a client rewrite or delete the line items of
      // their own invoice from the browser console. The itemisation is part of the
      // accounting record; a portal client has no legitimate write to it.
      allow update: if canManageBusinessDoc() && keepsBusinessId() && !isViewerRole()
        && (isSuperAdmin() || request.resource.data.get('invoiceId', null) == resource.data.get('invoiceId', null))
        && invoiceItemWriteAllowed(resource.data.get('invoiceId', ''), resource.data.businessId);
      allow delete: if canManageBusinessDoc() && !isViewerRole()
        && invoiceItemWriteAllowed(resource.data.get('invoiceId', ''), resource.data.businessId);
    }

    match /taskComments/{docId} {
      // Staff via businessId; portal client via customerId (stamped on create +
      // derived from the parent task by backfill-customerid).
      // A portal MEMBER of the task's project (projects.memberUserIds — not the
      // paying customer) reads its CLIENT-VISIBLE comments (customerId set). The
      // portal queries `taskId in [...]` + `customerId == <the project's>`, which
      // pins both values this clause needs (test 82f).
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || (resource.data.get('customerId', '') != ''
            && isPortalProjectMemberOfTask(resource.data.taskId))
        || isSuperAdmin();
      // A comment is written AS YOURSELF and is BOUND TO ITS TASK (tests 62, 82e):
      //  · staff — inside their tenant, on a task of that same business; it is
      //    internal (no customerId) or client-visible with exactly the task's
      //    customerId (never another client's);
      //  · the portal client of the task's customer, or a portal member of the
      //    task's project — senderType 'client', businessId and customerId copied
      //    from the task. Before, the comment only had to NAME the poster's own
      //    customer: any task id of any tenant was accepted.
      allow create: if isAuth()
        && request.resource.data.get('createdByUserId', '') == request.auth.uid
        && (
          isSuperAdmin()
          || (canCreateBusinessDoc()
              && taskOfCommentIn(request.resource.data.businessId)
              && (request.resource.data.get('customerId', null) == null
                  || request.resource.data.get('customerId', null) == ''
                  || request.resource.data.get('customerId', null) == commentTask().get('customerId', '')))
          || (request.resource.data.get('senderType', '') == 'client'
              && taskOfCommentIn(request.resource.data.get('businessId', ''))
              && commentTask().get('customerId', '') != ''
              && request.resource.data.get('customerId', '') == commentTask().get('customerId', '')
              && (isPortalClientFor(commentTask().get('customerId', ''))
                  || isPortalProjectMember(commentTask().get('projectId', ''))))
        );
      // Editing stays AUTHOR-only (and never re-tenants the row). A reaction is not
      // an edit: it is a collaborative action, so anyone who can already READ the
      // comment may toggle their own emoji — the diff must touch nothing but the
      // reaction map (plus the `updatedAt` that useMutation stamps automatically).
      // Without this branch every reaction on someone ELSE's comment was
      // denied by the rules and failed silently in the UI.
      allow update: if isAuth() && (
        // The author edits the CONTENT only: the task, the client-visibility key
        // and the tenant are pinned (an edit used to be able to re-target a
        // comment onto another task, or publish it to another client).
        (resource.data.createdByUserId == request.auth.uid && keepsBusinessId()
         && request.resource.data.get('createdByUserId', '') == resource.data.get('createdByUserId', '')
         && request.resource.data.get('taskId', null) == resource.data.get('taskId', null)
         && request.resource.data.get('customerId', null) == resource.data.get('customerId', null)
         // …and never the read receipts (a forged "Parë nga …" on their own comment).
         && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['readBy']))
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'updatedAt'])
          && (
            isBusinessMember(resource.data.businessId)
            || isPortalClientFor(resource.data.customerId)
            || (resource.data.get('customerId', '') != ''
                && isPortalProjectMemberOfTask(resource.data.get('taskId', '')))
            || isSuperAdmin()
          )
        )
        // Re-point on a task move (TaskPeopleRows.changeProject →
        // repointClientComments): non-Viewer staff of the business may change ONLY
        // customerId, ONLY on a comment that already HAS one (a client-visible
        // comment following its task's client), and only to the task's CURRENT
        // customerId or to nothing — a comment follows its task's client, it is
        // never published to an arbitrary one (test 82i), and an INTERNAL comment
        // is never published at all by this branch (test 84a): the UI touches
        // only rows with a customerId, so the rule says the same.
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['customerId', 'updatedAt'])
          && isBusinessMember(resource.data.businessId)
          && tenantActive(resource.data.businessId)
          && !isViewerRole()
          // (`is string`: a comment made internal writes `customerId: null`, and
          // `.get(k, '') != ''` is TRUE for a present null)
          && resource.data.get('customerId', '') is string
          && resource.data.get('customerId', '') != ''
          && (request.resource.data.get('customerId', null) == null
              || request.resource.data.get('customerId', null) == ''
              || (exists(/databases/$(database)/documents/tasks/$(resource.data.taskId))
                  && get(/databases/$(database)/documents/tasks/$(resource.data.taskId)).data.get('businessId', '') == resource.data.businessId
                  && get(/databases/$(database)/documents/tasks/$(resource.data.taskId)).data.get('customerId', '') == request.resource.data.customerId))
        )
        // Read receipt ("Parë", src/lib/taskReceipts.ts — tests 83g-83i): anyone
        // who can READ the comment (staff incl. Viewer; the portal client / project
        // member on a client-visible one) adds THEIR OWN key to `readBy`, valued
        // request.time — nothing else changes, and never on their own comment.
        || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
          && request.resource.data.readBy is map
          && request.resource.data.readBy.diff(resource.data.get('readBy', {})).affectedKeys().hasOnly([request.auth.uid])
          && request.resource.data.readBy[request.auth.uid] == request.time
          && resource.data.get('createdByUserId', '') != request.auth.uid
          && (
            isBusinessMember(resource.data.businessId)
            || isPortalClientFor(resource.data.get('customerId', ''))
            || (resource.data.get('customerId', '') != ''
                && isPortalProjectMemberOfTask(resource.data.get('taskId', '')))
          )
        )
      );
      // Deleting: the author, an Admin/Manager of the tenant, or — for the
      // task-delete cascade (src/lib/deleteCascade.ts), whose comments are rarely
      // all authored by whoever deletes the task — the task's creator or
      // assignee, the same people TasksView lets delete the task. Never a Viewer,
      // and no longer "any colleague" (test 82g).
      allow delete: if isSuperAdmin()
        || (isAuth() && resource.data.createdByUserId == request.auth.uid)
        || (canManageBusinessDoc() && !isViewerRole()
            && (isBusinessAdmin(resource.data.businessId)
                || ownsTaskOfComment(resource.data.get('taskId', ''), resource.data.businessId)));
    }

    // The task a comment is being written on (request side).
    function commentTask() {
      return get(/databases/$(database)/documents/tasks/$(request.resource.data.taskId)).data;
    }
    function taskOfCommentIn(businessId) {
      return request.resource.data.get('taskId', '') is string
        && request.resource.data.get('taskId', '') != ''
        && businessId is string && businessId != ''
        && exists(/databases/$(database)/documents/tasks/$(request.resource.data.taskId))
        && commentTask().get('businessId', '') == businessId;
    }
    function isPortalProjectMemberOfTask(taskId) {
      return taskId is string && taskId != ''
        && exists(/databases/$(database)/documents/tasks/$(taskId))
        && isPortalProjectMember(get(/databases/$(database)/documents/tasks/$(taskId)).data.get('projectId', ''));
    }
    function ownsTaskOfComment(taskId, businessId) {
      return taskId is string && taskId != ''
        && exists(/databases/$(database)/documents/tasks/$(taskId))
        && get(/databases/$(database)/documents/tasks/$(taskId)).data.get('businessId', '') == businessId
        && (get(/databases/$(database)/documents/tasks/$(taskId)).data.get('createdByUserId', '') == request.auth.uid
            || get(/databases/$(database)/documents/tasks/$(taskId)).data.get('assignedToUserId', '') == request.auth.uid);
    }

    // Collaborator records follow the task: written by non-Viewer staff only,
    // BOUND to a task of the same business (useCreateTask writes them right after
    // the task) and naming a real user id; the pair never moves by edit (test 84i).
    match /taskCollaborators/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc() && !isViewerRole()
        && request.resource.data.get('userId', '') is string
        && request.resource.data.get('userId', '') != ''
        && taskInBusiness(request.resource.data.get('taskId', ''), request.resource.data.businessId);
      allow update: if canManageBusinessDoc() && keepsBusinessId() && !isViewerRole()
        && request.resource.data.get('taskId', null) == resource.data.get('taskId', null)
        && request.resource.data.get('userId', null) == resource.data.get('userId', null);
      allow delete: if canManageBusinessDoc() && !isViewerRole();
    }
    function taskInBusiness(taskId, businessId) {
      return taskId is string && taskId != ''
        && exists(/databases/$(database)/documents/tasks/$(taskId))
        && get(/databases/$(database)/documents/tasks/$(taskId)).data.get('businessId', '') == businessId;
    }

    match /clientRequests/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isSuperAdmin();
      // Staff inside their tenant; a portal client creates a request FOR THEIR OWN
      // customer, inside their own tenant (isSelfCreate is tenant-bound).
      allow create: if canCreateBusinessDoc()
        || (isSelfCreate() && isPortalClientFor(request.resource.data.get('customerId', '')));
      // The portal client edits the content of their own request but never its
      // tenant/ownership keys; staff manage it inside the tenant.
      allow update: if (canManageBusinessDoc() && keepsBusinessId())
        || (isPortalClientFor(resource.data.customerId)
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['businessId', 'teamId', 'customerId', 'createdByUserId']));
      allow delete: if canManageBusinessDoc()
        || isPortalClientFor(resource.data.customerId);
    }

    match /customIndustries/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if canManageBusinessDoc() && keepsBusinessId();
      allow delete: if canManageBusinessDoc();
    }

    match /expenseCategories/{docId} {
      // Tenant taxonomy — was readable/writable by any signed-in user of any tenant.
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if canManageBusinessDoc() && keepsBusinessId();
      allow delete: if canManageBusinessDoc();
    }

    match /serviceCategories/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientOfBusiness(resource.data.businessId)
        || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if canManageBusinessDoc() && keepsBusinessId();
      allow delete: if canManageBusinessDoc();
    }

    match /projectComments/{docId} {
      // Staff via businessId; portal client via customerId (stamped on create +
      // derived from the parent project by backfill-customerid).
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isSuperAdmin();
      // Staff carry their businessId; a portal client comments AS THEMSELVES on a
      // project of their own customer (isSelfCreate is tenant-bound + customerId is
      // theirs), or on a project they were invited into as a member.
      allow create: if canCreateBusinessDoc()
        || (isSelfCreate()
            && request.resource.data.get('senderType', '') == 'client'
            && isPortalClientFor(request.resource.data.get('customerId', '')))
        || (isAuth()
            && request.resource.data.get('createdByUserId', '') == request.auth.uid
            && request.resource.data.get('senderType', '') == 'client'
            && isPortalProjectMember(request.resource.data.get('projectId', '')));
      // Editing stays AUTHOR-only (and never re-tenants the row). A reaction is not
      // an edit: it is a collaborative action, so anyone who can already READ the
      // comment may toggle their own emoji — the diff must touch nothing but the
      // reaction map (plus the `updatedAt` that useMutation stamps automatically).
      // Without this branch every reaction on someone ELSE's comment was
      // denied by the rules and failed silently in the UI.
      allow update: if isAuth() && (
        (resource.data.createdByUserId == request.auth.uid && keepsBusinessId()
         && request.resource.data.get('createdByUserId', '') == resource.data.get('createdByUserId', ''))
        || (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['reactions', 'updatedAt'])
          && (
            isBusinessMember(resource.data.businessId)
            || isPortalClientFor(resource.data.customerId)
            || isSuperAdmin()
          )
        )
      );
      // Deleting is author OR tenant staff, so the project-delete cascade can
      // actually remove the project's comments.
      allow delete: if (isAuth() && resource.data.createdByUserId == request.auth.uid)
        || canManageBusinessDoc();
    }

    match /serviceInquiries/{docId} {
      // Portal queries by clientUserId; staff by businessId.
      allow read: if isBusinessMember(resource.data.businessId)
        || (isAuth() && resource.data.clientUserId == request.auth.uid)
        || isSuperAdmin();
      // Portal clients submit their own inquiries INSIDE their tenant (isSelfCreate
      // is tenant-bound; useStartInquiry stamps businessId from useClientPortal);
      // staff carry their businessId.
      allow create: if canCreateBusinessDoc()
        || (isSelfCreate()
            && request.resource.data.get('clientUserId', request.auth.uid) == request.auth.uid);
      // The client edits the brief's CONTENT (draft steps, answers, the linked
      // lead), never who it belongs to or which tenant it sits in.
      allow update: if (canManageBusinessDoc() && keepsBusinessId())
        || (isAuth() && resource.data.clientUserId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys()
                 .hasAny(['businessId', 'teamId', 'clientUserId', 'customerId', 'createdByUserId']));
      allow delete: if canManageBusinessDoc()
        || (isAuth() && resource.data.clientUserId == request.auth.uid);
    }

    match /standups/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if canManageBusinessDoc() && keepsBusinessId();
      allow delete: if canManageBusinessDoc();
    }

    // dailyFocus — the personal "Most Important Task" (Eat That Frog). Read within
    // the business; a person manages only their own frog (managers/admins too).
    match /dailyFocus/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if ((isAuth() && resource.data.userId == request.auth.uid)
          || canManageBusinessDoc())
        && keepsBusinessId();
      allow delete: if (isAuth() && resource.data.userId == request.auth.uid)
        || canManageBusinessDoc();
    }

    // productivitySettings — per-team Momentum targets. Any business member reads;
    // only Admin/Manager/owner write (MomentumView's `isLeader`) — a member must
    // not be able to lower the targets their own score is measured against.
    match /productivitySettings/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if isSuperAdmin()
        || (isBusinessAdmin(request.resource.data.businessId) && tenantActive(request.resource.data.businessId));
      allow update: if isSuperAdmin()
        || (isBusinessAdmin(resource.data.businessId) && tenantActive(resource.data.businessId) && keepsBusinessId());
      allow delete: if isSuperAdmin() || isBusinessAdmin(resource.data.businessId);
    }

    // weeklyReviews — personal 4DX/GTD weekly review. Read within the business;
    // a person manages only their own review.
    match /weeklyReviews/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if ((isAuth() && resource.data.userId == request.auth.uid)
          || canManageBusinessDoc())
        && keepsBusinessId();
      allow delete: if (isAuth() && resource.data.userId == request.auth.uid)
        || canManageBusinessDoc();
    }

    // Statuses a quote must reach before a client may ever see it. A `Draft` is
    // internal pricing (margins, package contents, the manual discount) and the
    // portal used to fetch it and hide it in React — i.e. it sat in the client's
    // devtools. Rules are not filters, so PortalQuotesView constrains BOTH of its
    // queries with `where('status','in', CLIENT_VISIBLE_STATUSES)`; that list and
    // this one must stay identical or the query is denied outright.
    // DEPLOY NOTE: PortalDashboard.tsx runs the same two quote queries and must
    // carry the same constraint before this rule ships, or the portal dashboard
    // loses its quote counter.
    function quoteVisibleToClient() {
      return resource.data.get('status', 'Draft') in ['Sent', 'Accepted', 'Rejected'];
    }
    // The only fields a portal client may ever write on a quote, and the only
    // statuses they may write into them. Same shape as the customers rule
    // (tests 50a/50b): staff keep full update, the client gets a keyhole.
    function quotePortalResponse() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['status', 'respondedAt', 'updatedAt'])
        && resource.data.get('status', 'Draft') == 'Sent'
        && request.resource.data.status in ['Accepted', 'Rejected'];
    }

    match /quotes/{docId} {
      // Staff read via businessId; the portal client reads quotes for their own
      // customer (or a lead linked to it). Was `if isAuth()` — leaked every
      // tenant's quotes (incl. Draft pricing) to any signed-in user. Portal
      // accept/reject is an update, so the portal clause is allowed on update too.
      allow read: if isBusinessMember(resource.data.businessId)
        || (quoteAccessibleByPortal() && quoteVisibleToClient())
        || isSuperAdmin();
      allow create: if canCreateBusinessDoc() && !isViewerRole();
      // The portal clause used to be bare ownership: a client could rewrite
      // `result` (the totals and the package contents that ContractsView copies
      // verbatim into `packageSummary`) or flip a Draft to Accepted. They may now
      // only answer a quote that was actually SENT to them.
      allow update: if (canManageBusinessDoc() && keepsBusinessId() && !isViewerRole())
        || (quoteAccessibleByPortal() && quotePortalResponse())
        || isSuperAdmin();
      allow delete: if (canManageBusinessDoc() && !isViewerRole()) || isSuperAdmin();
    }

    // The ONLY write a portal client has on a contract: answering one that was
    // SENT to them — sign (as themselves) or reject — touching nothing but the
    // signature/decision fields (PortalContractsView.handleSign / handleReject).
    // Bare `isPortalClientFor()` used to let them rewrite the terms, the amount or
    // the PDF link, un-sign a signed contract, or delete it.
    function contractPortalResponse() {
      return resource.data.get('status', 'Draft') in ['Sent', 'Pending']
        && request.resource.data.get('status', '') in ['Signed', 'Rejected']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
             'status', 'signedAt', 'signedByUserId', 'signedByEmail', 'signatureData',
             'signatureType', 'rejectedAt', 'rejectionReason', 'updatedAt'])
        && (request.resource.data.status != 'Signed'
            || request.resource.data.get('signedByUserId', '') == request.auth.uid);
    }

    match /contracts/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isSuperAdmin();
      allow create: if canCreateBusinessDoc() && !isViewerRole();
      allow update: if (canManageBusinessDoc() && keepsBusinessId() && !isViewerRole())
        || (isPortalClientFor(resource.data.customerId) && contractPortalResponse());
      // A signed contract is a legal record — deleting it is a staff action.
      allow delete: if canManageBusinessDoc() && !isViewerRole();
    }

    // ── Global Collections (not team-scoped) ──

    // ── teams: a DEPARTMENT INSIDE a business ────────────────────────────────
    // `businessId` is REQUIRED on create and IMMUTABLE afterwards, so a team can
    // never be moved between tenants and never exists outside one. Reads are scoped:
    //   • members of the team's business (the normal, business-scoped team list),
    //   • the team's own creator (the "which teams do I own" bootstrap query),
    //   • a member of that specific team (single-document read by id),
    //   • super-admin (the platform console).
    // WAS `read: if isAuth()`, i.e. every tenant's org chart was public to any user.
    match /teams/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || (isAuth() && resource.data.createdByUserId == request.auth.uid)
        || isTeamMember(docId)
        || isSuperAdmin();
      // A new team must be planted inside a business the creator has ROSTER
      // AUTHORITY over (owner/admin claim), or a business they own — the very first
      // team of a fresh tenant, created by createTenant before any membership exists.
      // Plain membership was enough before: a Member created a department, became
      // its `createdByUserId` (= isTeamOwner), gave themselves an Admin membership
      // in it and was minted `roles: ['admin','owner']` on the next claims sync.
      allow create: if isAuth()
        && request.resource.data.businessId is string
        && request.resource.data.createdByUserId == request.auth.uid
        && (
          hasRosterAuthority(request.resource.data.businessId)
          || isBusinessOwner(request.resource.data.businessId)
          || isSuperAdmin()
        );
      // Tenant AND creator are immutable: re-pointing `createdByUserId` would hand
      // isTeamOwner() — and with it roster authority — to somebody else.
      allow update: if isAuth()
        && (resource.data.createdByUserId == request.auth.uid || isBusinessAdmin(resource.data.businessId) || isSuperAdmin())
        && (isSuperAdmin()
            || (request.resource.data.businessId == resource.data.businessId
                && request.resource.data.get('createdByUserId', '') == resource.data.get('createdByUserId', '')));
      allow delete: if isAuth()
        && (resource.data.createdByUserId == request.auth.uid || isSuperAdmin());
    }

    // ── businesses: the tenant / isolation boundary (Business > Team) ──
    match /businesses/{docId} {
      // WAS `read: if isAuth()` — the full tenant list (names, owners, plans, trial
      // state) was readable by every signed-in user, which is also how tenants got
      // enumerated for the takeover chain. Now: members, the owner, and the platform
      // console only. The portal resolves its tenant from `publicTenants` instead.
      allow read: if isBusinessMember(docId)
        || (isAuth() && resource.data.ownerId == request.auth.uid)
        || isSuperAdmin();
      // Self-serve signup: you may create a business you own — as a fresh TRIAL.
      //   • the id may not be an existing team's id: legacy tenants have
      //     `businessId == teamId` and NO businesses doc, so a caller-chosen id
      //     used to let anyone "found" a business over such a tenant and become
      //     its owner (isBusinessOwner / businesses.read / teams.create);
      //   • plan/status/entitlement/seats are the PLATFORM's to set (Stripe
      //     webhook, subscription-lifecycle cron, /api/platform-admin — all Admin
      //     SDK): a signup that arrives `plan: 'enterprise', status: 'active'`
      //     or with a ten-year trialEndsAt is self-service billing.
      //   • a self-serve signup is born with every optional module LOCKED and
      //     `moduleSetup: 'pending'` (createTenant.ts) — the platform decides what
      //     the tenant gets (`set-modules` opens it and writes 'done'). The lock
      //     list may be any list here (a signup can only withhold from itself; the
      //     registry lives in the client, so its content is not provable), but the
      //     flag may never be born 'done': that is what the console's work queue
      //     and the owner's "po konfigurohen" banner key on.
      allow create: if isAuth()
        && request.resource.data.ownerId == request.auth.uid
        && !exists(teamRef(docId))
        && request.resource.data.get('plan', 'trial') == 'trial'
        && request.resource.data.get('status', 'trialing') == 'trialing'
        && request.resource.data.get('lockedModules', []) is list
        && request.resource.data.get('moduleSetup', 'pending') == 'pending'
        && !request.resource.data.keys().hasAny([
             'seats', 'limits', 'stripeCustomerId', 'stripeSubscriptionId',
             'currentPeriodEnd', 'cancelAtPeriodEnd', 'portalSubdomain',
             'moduleSetupNotifiedAt', 'moduleSetupDoneAt'])
        && (!('trialEndsAt' in request.resource.data)
            || (request.resource.data.trialEndsAt is timestamp
                && request.resource.data.trialEndsAt <= request.time + duration.value(15, 'd')));
      // Owner manages their business; super-admin (claim) manages any (module toggles,
      // plan/status). `status` is deliberately owner-writable ONLY by the platform:
      // a tenant must not be able to un-suspend itself. `lockedModules` is the
      // platform's module ENTITLEMENT layer (what the contract includes) — the owner
      // keeps `disabledModules` (their own visibility choice) but cannot lift a lock,
      // or the super-admin's toggle would be a suggestion, not a control. The same
      // goes for seats / limits / trialEndsAt / the Stripe binding / ownerId.
      allow update: if isSuperAdmin()
        || (isAuth() && resource.data.ownerId == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
                 'status', 'plan', 'lockedModules', 'seats', 'limits', 'trialEndsAt', 'ownerId',
                 'stripeCustomerId', 'stripeSubscriptionId', 'currentPeriodEnd', 'cancelAtPeriodEnd',
                 'moduleSetup', 'moduleSetupRequestedAt', 'moduleSetupNotifiedAt', 'moduleSetupDoneAt']));
      allow delete: if isSuperAdmin();
    }

    // ── publicTenants/{subdomain}: the ONLY world-readable tenant metadata ───────
    // Minimal map (businessId, teamId, name) so `<sub>.fivocrm.com/portal` can resolve
    // its tenant WITHOUT `businesses` having to be public. Written only by the Admin
    // SDK / super-admin console.
    match /publicTenants/{subdomain} {
      allow read: if true;
      allow write: if isSuperAdmin();
    }

    // ── platformMetrics: one document per month of PLATFORM history ─────────────
    // Signups, trial→paid conversions, churn and MRR across every tenant — a
    // platform-operator artefact, not tenant data. No tenant may read it (it would
    // expose the shape of the whole customer base), and nobody may write it from a
    // client: the `platform-metrics-rollup` cron owns it via the Admin SDK.
    match /platformMetrics/{month} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ── platformJobRuns: the operator's job history ─────────────────────────────
    // Written by api/cron/run.ts (Admin SDK) after every execution. Read-only for the
    // console and immutable: an operations log that can be edited is worthless when
    // you are trying to reconstruct what a migration actually did.
    match /platformJobRuns/{runId} {
      allow read: if isSuperAdmin();
      allow write: if false;
    }

    // ── auditLogs: append-only, per-tenant ─────────────────────────────────────
    // "Who did what, when, in my tenant." Entries can be read inside the tenant by an
    // admin, created by the server (Admin SDK bypasses rules) and NEVER updated or
    // deleted by anyone — an audit trail that can be edited is not an audit trail.
    match /auditLogs/{docId} {
      allow read: if isBusinessAdmin(resource.data.businessId) || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update, delete: if false;
    }

    // ── contactMerges: the undo trail for a duplicate merge ────────────────────
    // Holds the FULL document of the absorbed lead/customer plus the counts of what
    // was reassigned, written by /api/merge-contacts (Admin SDK) before anything is
    // touched. It is the only remaining copy of a merged-away record, so a client may
    // read it inside its own tenant and nobody may ever write or erase it.
    match /contactMerges/{docId} {
      allow read: if isBusinessAdmin(resource.data.businessId) || isSuperAdmin();
      allow write: if false;
    }

    // ── teamSecrets: the tenant credential vault ───────────────────────────────
    // SMTP passwords, ESP/AI API keys, WhatsApp VPS secret, Meta page tokens. NO
    // client may read or write these: the app writes them through
    // /api/tenant-secrets (Admin SDK) and only ever sees the `has*` booleans mirrored
    // onto teamSettings. Previously these lived on `teamSettings`, which was
    // `read: if isAuth()` — every tenant's credentials were readable by any user.
    match /teamSecrets/{teamId} {
      allow read, write: if false;
    }

    // ── teamMemberComp: a member's PAY, out of reach of their colleagues ──────
    // `teamMembers` is readable by the whole business (the staff roster is), and it
    // carried `monthlySalary`, `salaryHistory` and `hourlyCostRate` — so any
    // employee, a Viewer included, could read every colleague's salary with one
    // query. Filtering it in React is not access control.
    //
    // Same document id as the membership row (`{teamId}_{userId}`), so a caller
    // that holds a member needs no lookup to find its pay.
    //
    //   read   — the member themselves, an admin/owner/manager of that business
    //            (isBusinessAdmin, the same set that approves expenses), or the
    //            platform operator. NOT every business member.
    //   write  — owner/admin only: canManageMembers(), exactly the authority that
    //            may already edit the membership row's salary today (`manager` is
    //            deliberately excluded there — a manager may SEE pay, not set it).
    //
    // On a LIST the engine evaluates this against the QUERY SHAPE, so:
    //   · an admin's list must pin `businessId ==` (useCollection does, because
    //     teamMemberComp is in businessIsolatedAlways) — that is what makes the
    //     isBusinessAdmin clause provable;
    //   · a plain member has no provable clause and their list is DENIED, by
    //     design — they read their own document by id instead
    //     (see useMemberCompensation).
    // Every `resource.data.X` goes through `.get(X, '')` for the reason spelled
    // out on teamMembers below: a raw access to a field the query does not
    // constrain ERRORS, and an error inside `a || b` denies the whole query.
    match /teamMemberComp/{docId} {
      allow read: if isSuperAdmin()
        || (isAuth() && resource.data.get('userId', '') == request.auth.uid)
        || isBusinessAdmin(resource.data.get('businessId', ''));
      // The id is part of the data model (it mirrors the membership id), so it is
      // pinned on create — the same gap teamMembers closes: a row whose id claims
      // one person while its data names another would let pay be written under
      // somebody else's key.
      allow create: if canManageMembers(
          request.resource.data.get('businessId', ''),
          request.resource.data.get('teamId', ''))
        && docId == request.resource.data.get('teamId', '')
                    + '_' + request.resource.data.get('userId', '');
      // An edit may never move a row to another tenant, another team or another
      // person — that would be a pay record silently re-pointed.
      allow update: if canManageMembers(
          resource.data.get('businessId', ''),
          resource.data.get('teamId', ''))
        && keepsBusinessId()
        && request.resource.data.get('teamId', '') == resource.data.get('teamId', '')
        && request.resource.data.get('userId', '') == resource.data.get('userId', '');
      allow delete: if canManageMembers(
        resource.data.get('businessId', ''),
        resource.data.get('teamId', ''));
    }

    match /teamMembers/{docId} {
      // ┌──────────────────────────────────────────────────────────────────────┐
      // │ FOLLOW-UP, IN THIS ORDER — do not do it from memory, and not before  │
      // │ the backfill has RUN and been verified against real data.            │
      // │                                                                      │
      // │ The read rule below still grants every `isBusinessMember` the whole   │
      // │ staff row, INCLUDING monthlySalary / salaryHistory / hourlyCostRate.  │
      // │ Compensation lives in `teamMemberComp` (above), which is correctly    │
      // │ restricted. The legacy fields are no longer written, but any that are │
      // │ still present are still READ as the fallback — so the leak is closed  │
      // │ only once step 3 has actually removed them.                           │
      // │                                                                      │
      // │   1. DONE — `?job=backfill-member-compensation` ran on 18 Sep 2026;   │
      // │      a later dry run reported 0 left to write.                        │
      // │   2. DONE — TeamsView writes pay ONLY to teamMemberComp, and strips   │
      // │      the three keys from what it sends to the roster row.             │
      // │   3. `?job=clear-legacy-member-pay` (super-admin, dryRun first) —     │
      // │      removes the three fields from `teamMembers`. It clears a member  │
      // │      ONLY when a comp document exists and agrees field for field, and │
      // │      refuses everyone else by name, so it cannot zero a payroll it    │
      // │      has not already seen preserved.                                  │
      // │   4. ONLY THEN is this read rule the last thing standing: leave it as │
      // │      is (the roster is legitimately readable by the business) — the   │
      // │      salary simply is not in it any more.                             │
      // │                                                                      │
      // │ Reverse that order and either payroll breaks or the leak stays open.  │
      // └──────────────────────────────────────────────────────────────────────┘
      // WAS `read: if isAuth()` — every tenant's staff records were readable by any
      // signed-in user, INCLUDING monthlySalary/salaryHistory/hourly rates. Now:
      //   • members of that business (the tenant's own staff list),
      //   • your own membership row (identity bootstrap, before a tenant is resolved),
      //   • the matching-email row (legacy records created before the uid was known),
      //   • super-admin (platform console).
      // The client portal no longer reads this collection at all — recipients and
      // routing are resolved server-side by /api/notify-staff.
      //
      // `.get('businessId', '')`, NOT `resource.data.businessId`: on a LIST the
      // engine evaluates the rule against the QUERY SHAPE, where `resource` holds
      // only the fields the query constrains. A raw access to an absent field
      // ERRORS, and an error inside `a || b` is only absorbed when the other side
      // is provably true — so the identity bootstrap query denied outright
      // ("Error fetching teamMembers: Missing or insufficient permissions") instead
      // of falling through to the userId/email clauses below.
      //   The e-mail clause needs a VERIFIED e-mail — a password sign-up with a
      //   colleague's address must not read (or, below, claim) their seat. The app
      //   shows VerifyEmailScreen to such users before any bootstrap query runs.
      allow read: if isBusinessMember(resource.data.get('businessId', ''))
        || (isAuth() && resource.data.get('userId', '') == request.auth.uid)
        || (verifiedEmail() && resource.data.get('email', '') == tokenEmail())
        || isSuperAdmin();
      // Owner/Admin of the tenant may add members client-side. The one legitimate
      // path for everyone else — accepting an invite — goes through the Admin SDK
      // (api/accept-invite), which validates the token + email and bypasses rules.
      // Still HARDENED against the original hole: a stranger cannot forge a
      // membership into a team they have no server-minted authority over.
      // The document ID is PART OF THE DATA MODEL here, not an opaque handle:
      // isTeamMember() resolves membership with exists() on
      // `teamMembers/{teamId}_{uid}`, and a dozen rules grant access on that alone.
      // Left unchecked, someone with roster authority in their OWN tenant could
      // create a row keyed `{victimTeam}_{theirUid}` while the row's DATA names
      // their own team — passing the authority check and minting themselves into
      // the victim's team. Pinning id == teamId + '_' + userId removes the gap
      // between what the id claims and what the data says. (Client writers now all
      // use that key; server paths use the Admin SDK and bypass rules.)
      // A team's creator may add members, but may not hand THEMSELVES an
      // Admin/Manager row unless they already hold roster authority in the
      // business (or own it — self-signup's first membership). Otherwise "create a
      // department" was a two-step self-promotion.
      allow create: if canCreateMembership(
          request.resource.data.get('businessId', ''),
          request.resource.data.get('teamId', ''))
        && docId == request.resource.data.get('teamId', '')
                    + '_' + request.resource.data.get('userId', '')
        && (request.resource.data.get('userId', '') != request.auth.uid
            || !(request.resource.data.get('role', 'Member') in ['Admin', 'Manager', 'Owner'])
            || hasRosterAuthority(request.resource.data.get('businessId', ''))
            || isBusinessOwner(request.resource.data.get('businessId', ''))
            || isSuperAdmin());
      // Prevent role self-escalation: users can update own record but only safe fields
      allow update: if isAuth() && (
        // Self-update: only displayName/email/position/updatedAt, role must not change.
        // `position` is the member's own CRAFT — it decides which questions their daily
        // report asks, nothing more. It is NOT authorisation (`role`) and NOT the P&L
        // allocation (`serviceLines`), both of which stay owner-only, so letting people
        // declare their own job at first login cannot escalate anything.
        (resource.data.get('userId', '') == request.auth.uid &&
         request.resource.data.get('role', '') == resource.data.get('role', '') &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['displayName', 'email', 'position', 'updatedAt'])) ||
        // Identity self-heal: a LEGACY row keyed by EMAIL (created before the uid
        // was known) may be re-pointed to the signer's own uid — and nothing else.
        // The old self-branch above required userId == uid, which is false for
        // exactly the rows that need repairing, so the auto-link in
        // usePermissions was denied every session and email-keyed members stayed
        // broken (empty "Detyrat e mia", reports flagged missing daily, ...).
        (verifiedEmail() &&
         resource.data.get('email', '') == tokenEmail() &&
         resource.data.get('userId', '') != request.auth.uid &&
         request.resource.data.get('userId', '') == request.auth.uid &&
         request.resource.data.diff(resource.data).affectedKeys()
           .hasOnly(['userId', 'updatedAt'])) ||
        // Managing a member (incl. role changes) requires roster authority — see
        // canManageMembers(): the team's creator, a server-minted owner/admin
        // claim, or the platform operator.
        //
        // The manager's OWN row is included on purpose. This branch used to carry
        // `resource.data.get('userId', '') != request.auth.uid`, which combined with the
        // narrow self-update allow-list above meant an owner/admin could never
        // save their own monthlySalary/salaryHistory/serviceLines/status — the
        // edit failed silently and their payroll stayed missing from every P&L.
        // Salary is a COST INPUT, not authorisation, and they may already set it
        // for every other member, so self-editing it grants nothing new.
        //
        // `role` is still pinned when editing yourself, so no one can promote
        // themselves and an owner cannot accidentally demote themselves out of
        // their own tenant.
        //
        // The three IDENTITY keys are pinned on every branch (the two self
        // branches through their allow-lists, this one explicitly): a member who
        // could re-point their own row's businessId/teamId/userId would have
        // `/api/sync-claims` mint `bid` for the victim tenant from it. The one
        // exception is a LEGACY row with no businessId at all, which may be filled
        // in ONCE — and only with the business its own team belongs to.
        (canManageMembers(resource.data.get('businessId', ''), resource.data.get('teamId', '')) &&
         request.resource.data.get('teamId', '') == resource.data.get('teamId', '') &&
         request.resource.data.get('userId', '') == resource.data.get('userId', '') &&
         (request.resource.data.get('businessId', '') == resource.data.get('businessId', '')
          || (resource.data.get('businessId', '') == ''
              && request.resource.data.get('businessId', '') == businessOfTeam(resource.data.get('teamId', '')))) &&
         (resource.data.get('userId', '') != request.auth.uid
          || request.resource.data.get('role', '') == resource.data.get('role', '')))
      );
      // Leaving yourself, or roster authority removing someone.
      allow delete: if isAuth() && (
        resource.data.get('userId', '') == request.auth.uid ||
        canManageMembers(resource.data.get('businessId', ''), resource.data.get('teamId', ''))
      );
    }

    // ── teamInvites: the privilege-escalation vector, now closed ───────────────
    // WAS create/read/update/delete for ANY signed-in user. Combined with
    // /api/accept-invite (which validated only "token + your email"), anyone could
    // forge an invite for their own address into ANY team and be granted an Admin
    // membership there — a full cross-tenant takeover. Now:
    //   • only an owner/Admin/Manager of that team may mint or manage an invite,
    //   • the invitee can read their own invite (email match) and accept it,
    //   • api/_accept-invite additionally verifies the invite's PROVENANCE.
    match /teamInvites/{docId} {
      // Every `resource.data.X` here goes through `.get(X, '')` for the same reason
      // as `teamMembers` above: on a LIST, `resource` carries only what the query
      // constrains, so a raw access to an absent field errors and DENIES the whole
      // query. That is what made the invitee's own lookup fail with
      // "Error looking up invite: Missing or insufficient permissions" — the email
      // clause was true, but the errored `isTeamAdmin(resource.data.teamId)` on its
      // left poisoned the OR. The invitee's query must ALSO constrain `email` (see
      // JoinInviteView), otherwise no clause is provable from the query shape.
      //
      // The `isTeamAdmin(teamId)` clause is provable only when the query pins a
      // teamId. TeamsView lists a tenant's invites by `businessId ==` alone (the
      // scope useCollection applies to every business-isolated collection), and
      // nothing below was provable from that shape — the list was denied for every
      // non-super-admin. Staff of the business may see who has been invited into
      // it, same as they already see the roster itself (`teamMembers` read).
      // The invitee's clause needs a VERIFIED e-mail: the row carries the accept
      // `token`, so an unverified password sign-up with the invitee's address could
      // read it and try to accept the seat.
      allow read: if isTeamAdmin(resource.data.get('teamId', ''))
        || isBusinessMember(resource.data.get('businessId', ''))
        || (verifiedEmail() && resource.data.get('email', '') == tokenEmail())
        || isSuperAdmin();
      allow create: if isTeamAdmin(request.resource.data.teamId)
        && request.resource.data.email is string
        // An invite may not mint an Admin unless the issuer is an owner/Admin.
        && (request.resource.data.get('role', 'Member') != 'Admin'
            || isTeamOwner(request.resource.data.teamId)
            || isSuperAdmin());
      // The invitee may only flip the acceptance bookkeeping on their own invite.
      allow update: if isTeamAdmin(resource.data.get('teamId', ''))
        || (verifiedEmail()
            && resource.data.get('email', '') == tokenEmail()
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['status', 'acceptedByUserId', 'acceptedAt', 'updatedAt']));
      allow delete: if isTeamAdmin(resource.data.get('teamId', '')) || isSuperAdmin();
    }

    match /userProfiles/{docId} {
      // Display names/avatars for @mentions and chat. Tenant-scoped like everything
      // else (the profile carries businessId, stamped on create + backfilled), with a
      // portal-of-business clause so a client can see the names of the staff they
      // actually talk to. Legacy profiles without businessId stay readable to their
      // owner only.
      allow read: if isBusinessMember(resource.data.get('businessId', ''))
        || isPortalClientOfBusiness(resource.data.get('businessId', ''))
        || (isAuth() && resource.data.userId == request.auth.uid)
        || isSuperAdmin();
      // Your own profile, planted in a tenant you actually belong to: staff
      // (claim, users marker, or — JoinInviteView, right after /api/accept-invite
      // and before the claims refresh — the membership row of the teamId you name),
      // or a portal client of it. A profile with a stranger's businessId would put
      // your display name into that tenant's mention list and chat directory.
      // The sales agent's bot profile (`salesagent_<bid>`, userId 'salesagent') is
      // written by the server only — it has no Auth user, so `userId == uid` already
      // excludes it; the explicit guard keeps that true if the clause above changes.
      allow create: if isAuth()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.get('userId', '') != 'salesagent'
        && !docId.matches('salesagent_.*')
        && profileTenantOk(request.resource.data.get('businessId', ''), request.resource.data.get('teamId', ''));
      // Own profile only; the tenant key is immutable once set (a legacy profile
      // with none may be filled in, under the same test as a create).
      allow update: if isAuth()
        && resource.data.userId == request.auth.uid
        && request.resource.data.get('userId', '') == request.auth.uid
        && (request.resource.data.get('businessId', '') == resource.data.get('businessId', '')
            || (resource.data.get('businessId', '') == ''
                && profileTenantOk(request.resource.data.get('businessId', ''), request.resource.data.get('teamId', ''))));
      allow delete: if false;
    }
    function profileTenantOk(bid, tid) {
      return !(bid is string) || bid == ''
        || isBusinessMember(bid)
        || isPortalClientOfBusiness(bid)
        || (tid is string && tid != ''
            && exists(membershipRef(tid, request.auth.uid))
            && get(membershipRef(tid, request.auth.uid)).data.get('businessId', '') == bid);
    }

    match /notifications/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      // WAS `create: if isAuth()` — anyone could inject a notification into ANY user's
      // feed (cross-tenant spam / phishing with an attacker-controlled actionUrl).
      // Now you may only notify yourself or someone in your own tenant. Portal clients
      // notify staff through /api/notify-staff (Admin SDK), which resolves recipients
      // from their own customer record.
      // `actionUrl` is a deep link INSIDE the app (rendered as a clickable button in
      // the bell, the push and the e-mail) — it must be a path, never an absolute
      // URL to somewhere else.
      allow create: if isAuth() && (
        request.resource.data.userId == request.auth.uid
        || notifyTargetInMyTenant(request.resource.data.userId)
        || isSuperAdmin()
      ) && (
        !(request.resource.data.get('actionUrl', '') is string)
        || request.resource.data.get('actionUrl', '') == ''
        // Mirrors isSafeAppPath (api/_callerIdentity.ts): a path that starts with
        // ONE slash — `//evil.com` is protocol-relative and `/\evil.com` is what
        // browsers normalise to it, so a second `/` or a `\` as the next character
        // is refused (tests 73, 84j).
        || request.resource.data.actionUrl.matches('/([^/\\\\].*)?')
      );
      // WAS `update: if owner` with no field guard — you could create a notification
      // for YOURSELF (always allowed above) and then update its userId to ANY uid on
      // the platform, bypassing the tenant check on create (cross-tenant phishing).
      // Update is now strictly "mark as read": userId pinned, only read-state fields.
      allow update: if isAuth() && resource.data.userId == request.auth.uid
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['isRead', 'readAt', 'updatedAt']);
      allow delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    match /clientPortalAccess/{docId} {
      // WAS `read: if isAuth()` — the portal roster of EVERY tenant (client emails +
      // which customer/team they map to) was readable by any signed-in user. Now:
      //   • staff of that tenant (docs carry businessId; backfilled by
      //     `backfill-tenant-keys`, and staff queries are business-scoped),
      //   • staff querying a specific customer they can already read,
      //   • the portal user themselves (own uid or own verified email).
      //   The e-mail clause requires a VERIFIED e-mail (see verifiedEmail).
      allow read: if isBusinessMember(resource.data.get('businessId', ''))
        || isPortalClientFor(resource.data.customerId)
        || (isAuth() && resource.data.get('userId', '') == request.auth.uid)
        || (verifiedEmail() && resource.data.get('email', '') == tokenEmail())
        || isSuperAdmin();
      // A portal-access row IS a portal identity (api/_tenantClaims mints `cid` /
      // `pbid` from it). Was `isSelfCreate() || isSuperAdmin()` with an
      // unconstrained customerId — any signed-in user could mint themselves an
      // identity for ANY existing customer of ANY tenant. Two ways in now:
      //   • STAFF of the customer's own tenant (CustomersView / CRMView /
      //     InvoicesView "Krijo akses" — `userId: ''`, no businessId stamped, so the
      //     tenant is read from the customer record itself);
      //   • the PORTAL USER themselves (useClientPortal / RegisterView bootstrap):
      //     verified token e-mail == the row's e-mail == the CUSTOMER's e-mail,
      //     userId == own uid, businessId (when stamped) == the customer's.
      allow create: if isSuperAdmin()
        || (isAuth()
            && request.resource.data.get('createdByUserId', '') == request.auth.uid
            && customerBusiness(request.resource.data.get('customerId', '')) != ''
            && isBusinessMember(customerBusiness(request.resource.data.get('customerId', '')))
            && tenantActive(customerBusiness(request.resource.data.get('customerId', '')))
            && (request.resource.data.get('businessId', '') == ''
                || request.resource.data.businessId == customerBusiness(request.resource.data.get('customerId', ''))))
        || (verifiedEmail()
            && request.resource.data.get('createdByUserId', '') == request.auth.uid
            && request.resource.data.get('userId', '') == request.auth.uid
            && request.resource.data.get('email', '') is string
            && request.resource.data.email.lower() == tokenEmail()
            && request.resource.data.get('customerId', '') is string
            && request.resource.data.customerId != ''
            && exists(usersCustomerRef(request.resource.data.customerId))
            && get(usersCustomerRef(request.resource.data.customerId)).data.get('email', '') is string
            && get(usersCustomerRef(request.resource.data.customerId)).data.email.lower() == tokenEmail()
            && !request.resource.data.keys().hasAny(['accessLevel', 'role'])
            && (request.resource.data.get('businessId', '') == ''
                || customerBusiness(request.resource.data.customerId) == ''
                || request.resource.data.businessId == customerBusiness(request.resource.data.customerId)));
      // Portal clients may only update their own safe fields.
      // Immutable fields (accessLevel, role, teamId, businessId, customerId, userId,
      // email) can NEVER be changed by the portal user — only the server-side Admin
      // SDK (or the tenant's staff, for revocation) may do so.
      allow update: if isAuth() && (
        // Initial claim: doc has no userId yet; VERIFIED email must match to prevent
        // hijacking — a password sign-up with the client's address is not the client.
        (resource.data.userId == '' &&
         verifiedEmail() &&
         resource.data.email.lower() == tokenEmail() &&
         request.resource.data.get('userId', '') == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['accessLevel', 'role', 'teamId', 'businessId', 'customerId', 'email', 'createdByUserId'])) ||
        // Existing owner: can update only safe display/state fields
        (resource.data.userId == request.auth.uid &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['accessLevel', 'role', 'teamId', 'businessId', 'customerId', 'userId', 'email', 'createdByUserId'])) ||
        // Staff of the tenant manage the row (status, accessLevel) but never re-point it.
        (isBusinessMember(resource.data.get('businessId', '')) &&
         !request.resource.data.diff(resource.data).affectedKeys()
           .hasAny(['businessId', 'customerId', 'userId', 'email'])) ||
        isSuperAdmin()
      );
      // Revoking portal access is a staff action (was: any signed-in user could
      // delete any tenant's portal access records).
      allow delete: if isBusinessMember(resource.data.get('businessId', ''))
        || (isAuth() && resource.data.get('userId', '') == request.auth.uid)
        || isSuperAdmin();
    }

    match /typingIndicators/{docId} {
      // Ephemeral, but it leaks who is talking to whom: scope to the tenant.
      allow read: if isBusinessMember(resource.data.get('businessId', ''))
        || (isAuth() && resource.data.get('userId', '') == request.auth.uid)
        || isTeamMember(resource.data.get('teamId', ''))
        || isSuperAdmin();
      // Written as yourself, inside your business (ChatView stamps businessId from the
      // active tenant). The teamId-only branch is gone: a teamId names no tenant.
      allow create: if isAuth()
        && request.resource.data.get('userId', '') == request.auth.uid
        && isBusinessMember(request.resource.data.get('businessId', ''));
      // Update is OWN-ONLY: the business-member branch let any colleague rewrite
      // someone else's indicator (forge/sustain "po shkruan…" indefinitely).
      // Colleagues may still DELETE a stale one (cleanup).
      allow update: if isAuth()
        && keepsBusinessId()
        && resource.data.get('userId', '') == request.auth.uid
        && request.resource.data.get('userId', '') == resource.data.get('userId', '');
      allow delete: if isAuth() && (
        resource.data.get('userId', '') == request.auth.uid
        || isBusinessMember(resource.data.get('businessId', ''))
        || isTeamMember(resource.data.get('teamId', ''))
      );
    }

    // Personal bookmarks of chat messages — each user can only see/modify their own.
    match /chatBookmarks/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Team-wide saved replies / snippets — the business reads them (teamId fallback
    // for legacy rows); created inside the writer's business (useMutation stamps
    // businessId); edited/deleted by the creator or the team owner.
    match /chatSnippets/{docId} {
      allow read: if isBusinessMember(resource.data.get('businessId', ''))
        || isTeamMember(resource.data.get('teamId', ''))
        || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if isAuth() && keepsBusinessId() && (
        resource.data.createdByUserId == request.auth.uid ||
        isTeamOwner(resource.data.teamId) ||
        isSuperAdmin()
      );
      allow delete: if isAuth() && (
        resource.data.createdByUserId == request.auth.uid ||
        isTeamOwner(resource.data.teamId) ||
        isSuperAdmin()
      );
    }

    // Personal chat reminders / snooze — each user can only see/modify their own.
    match /chatReminders/{docId} {
      allow read: if isAuth() && resource.data.userId == request.auth.uid;
      allow create: if isAuth() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAuth() && resource.data.userId == request.auth.uid;
    }

    // Scheduled outgoing messages ("Programo") — each user sees/manages only their
    // own. The `chat-scheduled` cron SENDS them with the Admin SDK, i.e. WITHOUT
    // re-checking who the target is — so the target is checked HERE, at creation:
    // a DM target must be inside my tenant, a client thread must be one I can
    // reach, and the routing keys can never be re-pointed after the fact (a row
    // scheduled into my own DM and then re-aimed at a victim would have been sent
    // by the cron with nobody looking).
    match /chatScheduledMessages/{docId} {
      allow read: if isAuth() && resource.data.senderId == request.auth.uid;
      // businessId is REQUIRED and must be the caller's own tenant: the cron sends
      // with the Admin SDK and scopes its suspended-tenant guard, its manual-run
      // scope and the message/notification tenant stamp by this field — an absent
      // or foreign businessId made every one of those a no-op. A GROUP channelId
      // is membership-checked here too (and re-checked by the cron): a row minted
      // into a private group — or another tenant's group — the sender is not a
      // member of used to be sent with nobody looking.
      allow create: if isAuth()
        && request.resource.data.get('senderId', '') == request.auth.uid
        && request.resource.data.get('createdByUserId', request.auth.uid) == request.auth.uid
        && isBusinessMember(request.resource.data.get('businessId', ''))
        && (!(request.resource.data.get('directUserId', '') is string)
            || request.resource.data.get('directUserId', '') == ''
            || isUserInMyTenant(request.resource.data.directUserId))
        && (!isClientChannelId(request.resource.data.get('channelId', ''))
            || canWriteClientChannel(request.resource.data.channelId))
        && (!(request.resource.data.get('channelId', '') is string)
            || request.resource.data.get('channelId', '') == ''
            || isClientChannelId(request.resource.data.channelId)
            || isGroupChannelMember(request.resource.data.channelId));
      allow update: if isAuth() && resource.data.senderId == request.auth.uid
        && !request.resource.data.diff(resource.data).affectedKeys()
             .hasAny(['senderId', 'channelId', 'directUserId', 'businessId', 'teamId', 'createdByUserId']);
      allow delete: if isAuth() && resource.data.senderId == request.auth.uid;
    }

    // directMessages: unused collection (DMs live in `messages`). Locked to deny —
    // it was an open, dead attack surface (read/update/delete: if isAuth()).
    match /directMessages/{docId} {
      allow read, write: if false;
    }

    match /milestones/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc() && !isViewerRole();
      allow update: if canManageBusinessDoc() && keepsBusinessId() && !isViewerRole();
      allow delete: if canManageBusinessDoc() && !isViewerRole();
    }

    // Workspace folders / Drive references: created inside the writer's business
    // (useMutation stamps businessId — the teamId-only create branch named no
    // tenant); the team clause stays only for LEGACY rows that carry no businessId,
    // which a create can no longer produce.
    match /workspaceFolders/{docId} {
      allow read: if isBusinessMember(resource.data.get('businessId', ''))
        || isTeamMember(resource.data.get('teamId', ''))
        || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if isAuth() && keepsBusinessId() && (
        isBusinessMember(resource.data.get('businessId', ''))
        || (resource.data.get('businessId', '') == '' && isTeamMember(resource.data.get('teamId', '')))
      );
      allow delete: if isAuth() && (
        isBusinessMember(resource.data.get('businessId', ''))
        || (resource.data.get('businessId', '') == '' && isTeamMember(resource.data.get('teamId', '')))
      );
    }

    match /workspaceDriveFiles/{docId} {
      // Google-Drive file references: names + links to a tenant's documents.
      allow read: if isBusinessMember(resource.data.get('businessId', ''))
        || isTeamMember(resource.data.get('teamId', ''))
        || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if isAuth() && keepsBusinessId() && (
        isBusinessMember(resource.data.get('businessId', ''))
        || (resource.data.get('businessId', '') == '' && isTeamMember(resource.data.get('teamId', '')))
      );
      allow delete: if isAuth() && (
        isBusinessMember(resource.data.get('businessId', ''))
        || (resource.data.get('businessId', '') == '' && isTeamMember(resource.data.get('teamId', '')))
      );
    }

    match /roleTemplates/{docId} {
      // Permission presets — an attacker reading/altering another tenant's templates
      // is an authorization-policy tamper, so this is admin-gated inside the tenant.
      allow read: if isBusinessMember(resource.data.get('businessId', ''))
        || isTeamMember(resource.data.get('teamId', ''))
        || isSuperAdmin();
      allow create: if isAuth() && (
        isBusinessAdmin(request.resource.data.get('businessId', ''))
        || isTeamAdmin(request.resource.data.get('teamId', ''))
      );
      allow update, delete: if isAuth() && (
        isBusinessAdmin(resource.data.get('businessId', ''))
        || isTeamAdmin(resource.data.get('teamId', ''))
      );
    }

    match /whatsappMessages/{docId} {
      // Team-scoped: a user may only touch messages belonging to their team.
      // Client list queries always filter by teamId (see CRMView/ChatView/
      // WhatsAppChatPanel), so these per-doc rules hold for queries too.
      // Server writes use the Admin SDK and bypass rules.
      // `businessId` is stamped by api/_waInbound.ts on every new row (additive —
      // legacy rows carry only teamId and stay readable through the team clause).
      allow read: if isTeamMember(resource.data.get('teamId', ''))
        || isBusinessMember(resource.data.get('businessId', ''));
      // `businessId`, when stamped by the client, must be the writer's own tenant;
      // updates PIN teamId + businessId — an update checked only against the OLD
      // teamId could re-point the row into another tenant's WA inbox (forged
      // "customer" messages delivered inside the victim's CRM).
      allow create: if isTeamMember(request.resource.data.teamId)
        && (!(request.resource.data.get('businessId', '') is string)
            || request.resource.data.get('businessId', '') == ''
            || isBusinessMember(request.resource.data.businessId));
      allow update: if isTeamMember(resource.data.teamId)
        && request.resource.data.get('teamId', '') == resource.data.get('teamId', '')
        && request.resource.data.get('businessId', '') == resource.data.get('businessId', '');
      allow delete: if isTeamMember(resource.data.teamId);
    }

    // Per-tenant daily counters written by the inbound WhatsApp handler (auto-created
    // lead cap) and the AI-draft cap (B3). Server-only: a client that could reset the
    // counter could lift its own cap.
    match /waInboundCounters/{docId} {
      allow read, write: if false;
    }
    // Archive of leads/messages deleted because they came from a WhatsApp channel/
    // group (not a person). Server-only, like every other cleanup archive.
    match /waNonPersonCleanup/{docId} {
      allow read, write: if false;
    }
    match /aiDailyUsage/{docId} {
      allow read, write: if false;
    }

    match /whatsappConversations/{docId} {
      // Per-(team,phone) doc used to track lastInboundAt for the 24h window.
      // Reads scoped to the user's team.  Writes happen server-side from the
      // webhook / VPS (Admin SDK), so client writes stay locked down.
      allow read: if isTeamMember(resource.data.teamId);
      allow create, update, delete: if false;
    }

    match /whatsappAccounts/{docId} {
      // Baileys agent config (labels, assignment, connected phone). Not a credential,
      // but it is tenant data: it reveals another tenant's phone numbers and staff
      // assignment. Scoped to the business, with a teamId fallback for legacy docs
      // (the earlier strict isTeamMember-only variant denied legitimate owner deletes
      // when the active-team marker lagged a team switch).
      // Managing an agent (adding a number, switching it off, deleting it — which
      // logs the VPS session out) is Cilësimet → Admin/Owner only; a member may read.
      allow read: if isBusinessMember(resource.data.get('businessId', ''))
        || isTeamMember(resource.data.get('teamId', ''))
        || isSuperAdmin();
      allow create: if isSuperAdmin()
        || (isBusinessAdmin(request.resource.data.get('businessId', ''))
            && tenantActive(request.resource.data.get('businessId', '')));
      allow update: if isSuperAdmin()
        || (isBusinessAdmin(resource.data.get('businessId', '')) && keepsBusinessId())
        || (resource.data.get('businessId', '') == '' && isTeamAdmin(resource.data.get('teamId', '')) && keepsBusinessId());
      allow delete: if isSuperAdmin()
        || isBusinessAdmin(resource.data.get('businessId', ''))
        || (resource.data.get('businessId', '') == '' && isTeamAdmin(resource.data.get('teamId', '')));
    }

    match /whatsappThreads/{docId} {
      // Team-scoped per-conversation metadata managed from the Inbox UI:
      // assignment, internal notes, status (open/pending/closed).  Keyed
      // {teamId}_{phone}.  Client-writable (unlike whatsappConversations).
      allow read: if isTeamMember(resource.data.teamId);
      // Same pinning as whatsappMessages: a re-pointed teamId planted forged
      // thread notes/status in another tenant's WA inbox.
      allow create: if isTeamMember(request.resource.data.teamId)
        && (!(request.resource.data.get('businessId', '') is string)
            || request.resource.data.get('businessId', '') == ''
            || isBusinessMember(request.resource.data.businessId));
      allow update: if isTeamMember(resource.data.teamId)
        && request.resource.data.get('teamId', '') == resource.data.get('teamId', '')
        && request.resource.data.get('businessId', '') == resource.data.get('businessId', '');
      allow delete: if isTeamMember(resource.data.teamId);
    }

    // ── Marketing (WhatsApp / e-mail templates, broadcasts, campaigns, drips) ──
    // Business-scoped: queries filter by businessId and useMutation stamps it on
    // create, so the create is `canCreateBusinessDoc()` alone. The old
    // `|| isTeamMember(request.resource.data.teamId)` create branch let a caller
    // stamp ANY businessId next to a team they were in — a campaign that then sent
    // to (and read the audience of) another tenant. A team clause survives only for
    // LEGACY rows that carry no businessId (read + edit), which a create can no
    // longer produce.
    function legacyTeamRow() {
      return resource.data.get('businessId', '') == '' && isTeamMember(resource.data.get('teamId', ''));
    }
    match /waTemplates/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isTeamMember(resource.data.teamId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if (canManageBusinessDoc() && keepsBusinessId()) || (legacyTeamRow() && keepsBusinessId());
      allow delete: if canManageBusinessDoc() || legacyTeamRow();
    }

    match /waBroadcasts/{docId} {
      // Created/edited from the UI; the cron processor advances status/sentCount
      // via the Admin SDK (bypasses these rules).
      allow read: if isBusinessMember(resource.data.businessId) || isTeamMember(resource.data.teamId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if (canManageBusinessDoc() && keepsBusinessId()) || (legacyTeamRow() && keepsBusinessId());
      allow delete: if canManageBusinessDoc() || legacyTeamRow();
    }

    match /emailTemplates/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isTeamMember(resource.data.teamId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if (canManageBusinessDoc() && keepsBusinessId()) || (legacyTeamRow() && keepsBusinessId());
      allow delete: if canManageBusinessDoc() || legacyTeamRow();
    }

    match /emailCampaigns/{docId} {
      // Created/edited from the UI; the cron processor advances status/sentCount
      // via the Admin SDK (bypasses these rules).
      allow read: if isBusinessMember(resource.data.businessId) || isTeamMember(resource.data.teamId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if (canManageBusinessDoc() && keepsBusinessId()) || (legacyTeamRow() && keepsBusinessId());
      allow delete: if canManageBusinessDoc() || legacyTeamRow();
    }

    // ── CRM automation rules (CRM → Automatizime) ──
    // A rule assigns, emails and creates tasks inside its tenant, so only the
    // tenant's elevated roles may author one; every member may read them (the
    // builder shows who set what up). The tenant key is immutable.
    match /crmAutomationRules/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if isSuperAdmin()
        || (isBusinessAdmin(request.resource.data.businessId) && tenantActive(request.resource.data.businessId));
      allow update: if isSuperAdmin()
        || (isBusinessAdmin(resource.data.businessId) && tenantActive(resource.data.businessId) && keepsBusinessId());
      allow delete: if isSuperAdmin() || isBusinessAdmin(resource.data.businessId);
    }
    // One document per firing — the idempotency record AND the audit trail. Written
    // ONLY by the cron (Admin SDK): a client that could write here could either
    // re-fire an occurrence (delete) or silence one forever (create).
    match /crmAutomationRuns/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow write: if false;
    }

    // ── Virtual sales agent ("Ana") — workspace/SALES_AGENT_PLAN.md ──
    // A Google Maps search request. The BROWSER only queues it (status 'queued',
    // zeroed counters, as itself); the cron (Admin SDK) runs it and writes the
    // results, so an update from a client is never legitimate. A queued row may be
    // withdrawn by an Admin/Manager; a running/done one is history.
    match /prospectSearches/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if isSuperAdmin()
        || (isBusinessMember(request.resource.data.businessId)
            && tenantActive(request.resource.data.businessId)
            && !isViewerRole()
            && request.resource.data.get('status', '') == 'queued'
            && request.resource.data.get('requestedByUserId', '') == request.auth.uid
            && prospectSearchCountsZero());
      allow update: if isSuperAdmin();
      allow delete: if isSuperAdmin()
        || (isBusinessAdmin(resource.data.businessId) && resource.data.get('status', '') == 'queued');
    }
    function prospectSearchCountsZero() {
      return request.resource.data.counts is map
        && request.resource.data.counts.get('found', 1) == 0
        && request.resource.data.counts.get('new', 1) == 0
        && request.resource.data.counts.get('duplicate', 1) == 0
        && request.resource.data.counts.get('registered', 1) == 0
        && request.resource.data.counts.get('requests', 1) == 0;
    }
    // One business found on Maps. Created by the cron, expired by the TTL job,
    // registered as a lead by the endpoint (`leadId`, status 'registered' /
    // 'duplicate', the outreach stamps, `waVerified`, the fit score and the Google
    // place id are all server-owned). Staff triage only: approve / reject / undo,
    // and never on a row that already became a lead.
    match /prospects/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if isSuperAdmin();
      allow update: if isSuperAdmin()
        || (isBusinessMember(resource.data.businessId)
            && tenantActive(resource.data.businessId)
            && !isViewerRole()
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectReason', 'updatedAt'])
            && resource.data.get('status', '') in ['new', 'approved', 'rejected']
            && request.resource.data.get('status', '') in ['new', 'approved', 'rejected']);
      allow delete: if isSuperAdmin() || isBusinessOwnerOrAdmin(resource.data.businessId);
    }
    // The facts the agent may state (FAQ, objections, policies). Admin/Manager
    // author them; everyone in the business reads them; the portal never sees them.
    match /salesKnowledge/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create: if isSuperAdmin()
        || (isBusinessAdmin(request.resource.data.businessId) && tenantActive(request.resource.data.businessId));
      allow update: if isSuperAdmin()
        || (isBusinessAdmin(resource.data.businessId) && tenantActive(resource.data.businessId) && keepsBusinessId());
      allow delete: if isSuperAdmin() || isBusinessAdmin(resource.data.businessId);
    }
    // Server-only ledgers: one run doc per agent decision (idempotency + audit),
    // the daily digest claim, the per-sender cold-WhatsApp counters and the AI /
    // Places usage. A client that could write here could re-arm a reply, silence
    // one forever, or reset a sender's quota.
    match /salesAgentRuns/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow write: if false;
    }
    match /salesAgentDigests/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow write: if false;
    }
    match /salesAgentSenders/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow write: if false;
    }
    match /salesAgentUsage/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow write: if false;
    }
    // `leads.agent*` / prospect / cold-outreach stamps are written by the agent
    // endpoint and jobs only (same law as the task engine flags): a client that
    // could set `agentQualifiedAt` or clear `coldWaSentAt` would forge a
    // qualification or re-arm a cold message.
    function leadAgentServerKeys() {
      return ['agentQualifiedAt', 'agentScore', 'agentSummary', 'agentCollected', 'prospectId', 'coldWaSentAt', 'coldEmailSentAt'];
    }
    function leadAgentKeysUntouched() {
      return isSuperAdmin()
        || !request.resource.data.diff(resource.data).affectedKeys().hasAny(leadAgentServerKeys());
    }
    function leadAgentKeysAbsent() {
      return isSuperAdmin() || !request.resource.data.keys().hasAny(leadAgentServerKeys());
    }
    // `conversations.agent` (stage, collected fields, handoff) is the agent's own
    // state; handoff / resume go through POST /api/sales-agent, which audits them.
    function conversationAgentUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['agent']);
    }

    match /campaignEnrollments/{docId} {
      // Per-recipient drip-sequence progress. Created + advanced by the cron
      // (Admin SDK); clients read their business's for reporting.
      allow read: if isBusinessMember(resource.data.businessId) || isTeamMember(resource.data.teamId) || isSuperAdmin();
      allow create: if canCreateBusinessDoc();
      allow update: if (canManageBusinessDoc() && keepsBusinessId()) || (legacyTeamRow() && keepsBusinessId());
      allow delete: if canManageBusinessDoc() || legacyTeamRow();
    }

    // ── Social Media analytics (Meta) ──
    // socialAccounts holds long-lived Page access tokens → NEVER exposed to the
    // client SDK. Both the staff UI (via api/social) and the cron sync use the
    // Admin SDK, which bypasses rules. Deny all client access outright.
    match /socialAccounts/{docId} {
      allow read, write: if false;
    }

    // socialSnapshots are the derived, token-free monthly reports. Staff read
    // their business's snapshots (queries filter by businessId); the portal client
    // reads only their own customer's (portal query is `where customerId == myId`).
    // Written exclusively by the Admin SDK sync — no client writes.
    match /socialSnapshots/{docId} {
      allow read: if isBusinessMember(resource.data.businessId)
        || isPortalClientFor(resource.data.customerId)
        || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // ── Google Reviews (Business Profile) ──
    // gmbAccounts holds Google OAuth refresh tokens → NEVER exposed to the client
    // SDK. The staff UI gets a token-stripped list via /api/gmb; sync/reply/post
    // all run through the Admin SDK. Deny all client access outright.
    match /gmbAccounts/{docId} {
      allow read, write: if false;
    }

    // gmbReviews are the token-free mirrored reviews. Staff read their business's
    // (queries filter by businessId); every write (sync, reply, report mark) goes
    // through /api/gmb so the mirror can never diverge from Google by a client edit.
    match /gmbReviews/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    // gmbPosts mirror what was published to the Google profile — same regime.
    match /gmbPosts/{docId} {
      allow read: if isBusinessMember(resource.data.businessId) || isSuperAdmin();
      allow create, update, delete: if false;
    }

    match /lidMappings/{docId} {
      // WhatsApp LID ↔ phone mapping. Written by the VPS/webhook (Admin SDK) and read
      // by the Inbox; keep it tenant-scoped with a teamId fallback for legacy rows.
      // Nothing in the app writes it from a browser (grep: no client writer), so a
      // client write stays closed: a forged mapping would re-route a conversation.
      allow read: if isBusinessMember(resource.data.get('businessId', ''))
        || isTeamMember(resource.data.get('teamId', ''))
        || isSuperAdmin();
      allow create, update: if isSuperAdmin();
      allow delete: if false;
    }

    // ── teamSettings: one doc per team, keyed by teamId ──
    // Stores bank accounts, EUR rate, WhatsApp/Meta config, cron settings.
    // Written by an Admin/Manager of the team or of its business (isTeamAdmin /
    // isBusinessAdmin) — not only the team's creator.
    //
    // The credential fields that may NEVER land here. This list is the MIRROR of
    // `SECRET_FIELDS` in api/_tenantConfig.ts — scripts/firestore-rules.test.mjs
    // reads that file and fails when a key is missing here.
    function teamSettingsSecretKeys() {
      return ['aiApiKey', 'emailApiKey', 'emailSmtpPass', 'whatsappVpsSecret',
              'metaWebhookVerifyToken', 'metaChannelTokens', 'gmbClientSecret', 'dynadotApiKey', 'googlePlacesApiKey'];
    }
    match /teamSettings/{teamId} {
      // Non-secret tenant configuration (company identity, bank accounts, FX rates,
      // feature flags, channel metadata, `has*` credential markers).
      // WAS `read: if isAuth()` while ALSO holding emailApiKey / emailSmtpPass /
      // aiApiKey / whatsappVpsSecret / Meta access tokens — i.e. every tenant's
      // credentials were readable by every signed-in user, portal clients included.
      // Credentials now live in `teamSecrets` (deny-all); this document is readable
      // by the tenant's STAFF only. The portal used to read it for the file-upload
      // host; useFileUpload no longer does, and a client has no business seeing the
      // tenant's bank accounts, FX rate or channel configuration.
      allow read: if isBusinessMember(businessOfTeam(teamId))
        || isTeamMember(teamId)
        || isSuperAdmin();
      // Never allow a client to write credential fields here, even as an admin: they
      // would be readable by every member of the business. /api/tenant-secrets is the
      // only path (it writes teamSecrets and strips any plaintext copy).
      // NOTE: `write` covers create too, where `resource` is null — hence the null
      // guard (a diff() against a missing document raises and would deny, breaking
      // tenant signup). On update only the CHANGED keys are inspected, so a tenant
      // that still has a legacy plaintext secret in the document can keep editing
      // other fields until the `migrate-team-secrets` job cleans it up.
      allow write: if (isTeamAdmin(teamId) || isBusinessAdmin(businessOfTeam(teamId)))
        && (
          resource == null
            ? !request.resource.data.keys().hasAny(teamSettingsSecretKeys())
            : !request.resource.data.diff(resource.data).affectedKeys().hasAny(teamSettingsSecretKeys())
        )
        // The company's MONEY configuration — the bank accounts printed on every
        // invoice (and emailed to clients), the employer-cost / capacity settings
        // and the rate card behind every cost/hour — is owner/Admin only. A
        // Manager runs a department; changing the IBAN clients pay into or the
        // cost rate of every colleague is a company-level decision.
        && (isTeamSettingsFinanceWriter(teamId)
            || (resource == null
                ? !request.resource.data.keys().hasAny(teamSettingsFinanceKeys())
                : !request.resource.data.diff(resource.data).affectedKeys().hasAny(teamSettingsFinanceKeys())));
    }
    // The virtual sales agent's configuration (autonomy level, cold-WhatsApp
    // quota, persona) is in the same tier as the money settings: raising the
    // autonomy or switching cold outreach on is a company-level decision, not a
    // department's. Everything else in teamSettings stays Admin/Manager.
    function teamSettingsFinanceKeys() {
      return ['bankAccounts', 'financeSettings', 'rateCard', 'salesAgent'];
    }
    // Owner/Admin of the team's business: the signed claim (isBusinessOwnerOrAdmin),
    // the business doc's owner, the team's creator, or an active `Admin`
    // membership row (tokens that predate the `roles` claim).
    function isTeamSettingsFinanceWriter(teamId) {
      return isSuperAdmin()
        || isBusinessOwnerOrAdmin(businessOfTeam(teamId))
        || isBusinessOwner(businessOfTeam(teamId))
        || isTeamOwner(teamId)
        || (isAuth() && teamId is string
            && exists(membershipRef(teamId, request.auth.uid))
            && get(membershipRef(teamId, request.auth.uid)).data.get('role', '') == 'Admin'
            && get(membershipRef(teamId, request.auth.uid)).data.get('status', 'Active') != 'Inactive');
    }

    // ── counters: atomic invoice number sequences ──
    // Read/bump by the members of the business (transaction-safe via the Firestore
    // SDK); a Viewer issues no invoices and so bumps no sequence.
    // Keyed `invoices_{businessId}` (getNextInvoiceNumber
    // in src/lib/firebase.ts, InvoicesView, ProjectsView — the sequence is
    // per TENANT, because teams are departments of one company and share one
    // invoice book). Legacy docs keyed `invoices_{teamId}` are still honoured.
    // WAS read/write for any signed-in user: another tenant could read your
    // invoice volume or bump your sequence. Then it was authorised via
    // `teams/{id}` only — which does not exist for a business id, so every
    // non-super-admin was denied and the client fell back to a non-atomic number
    // (the collision fix-invoice-number-collisions.mjs exists for).
    function counterScopeOk(scopeId) {
      return isBusinessMember(scopeId)
        || isTeamMember(scopeId)
        || isBusinessMember(businessOfTeam(scopeId));
    }
    match /counters/{docId} {
      allow read: if isSuperAdmin()
        || (isAuth() && counterScopeOk(docId.split('_')[1]));
      allow create: if isSuperAdmin()
        || (isAuth() && !isViewerRole() && counterScopeOk(docId.split('_')[1]));
      // MONOTONIC: a sequence only ever moves forward. Resetting `last` re-issues
      // numbers that already exist on invoices — an accounting integrity issue —
      // so a lower value is refused even for a legitimate member (the transaction
      // in getNextInvoiceNumber always writes max(stored, highest existing) + 1).
      allow update: if isSuperAdmin()
        || (isAuth() && !isViewerRole() && counterScopeOk(docId.split('_')[1])
            && request.resource.data.get('last', 0) is number
            && request.resource.data.get('last', 0) >= resource.data.get('last', 0));
      // Deleting the sequence is a reset by another name.
      allow delete: if isSuperAdmin();
    }

    // ── users: per-user preferences and flags ──
    // Stores onboardingCompleted and other per-user state.
    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      // HARDENED: a user may write their own doc, but may only set the tenant keys
      // (teamId/businessId/customerId) to values backed by a real membership / their
      // own customer. Super-admins (claim) bypass. This is what stops an attacker from
      // self-attesting into a victim tenant via users/{uid}.businessId.
      allow create, update: if request.auth.uid == userId
        && (usersTenantOk(userId) || isSuperAdmin());
    }

    // ── userPreferences: per-user notification preferences, DND settings ──
    // Stores notification category toggles, DND schedule, digest settings.
    match /userPreferences/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;
    }

    // ── notificationThrottle: server-only email coalescing state ──
    // One doc per user holding "when did we last EMAIL them about this category".
    // Chat is realtime, so a live conversation used to produce one email per message
    // (and burn the relay's hourly budget with it) — api/_push.ts
    // shouldThrottleCategoryEmail coalesces the `messages` category to one email per
    // 15 minutes. Push and the bell row are never throttled.
    // Written only by the Admin SDK; nothing client-side reads it, so it is closed
    // outright rather than left to the default deny.
    match /notificationThrottle/{userId} {
      allow read, write: if false;
    }

    // ── userPushTokens: FCM push tokens per user ──
    // The parent doc is the LEGACY single-token record (one device per user, which is
    // why registering on a second device silently killed push on the first). Devices
    // now each get their own doc in the `tokens` subcollection; the parent is kept
    // readable/writable so old clients keep working until they re-register.
    match /userPushTokens/{userId} {
      allow read, write: if isAuth() && request.auth.uid == userId;

      match /tokens/{deviceKey} {
        allow read, write: if isAuth() && request.auth.uid == userId;
      }
    }
  }
}
