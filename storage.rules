rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Staff uploads: scoped by teamId in the path
    // Path layout: {teamId}/{folder}/{filename}
    match /{teamId}/{folder}/{fileName} {
      // Public read so <img src=...> works without a token round-trip.
      // Files only get a signed URL by accident if we wanted privacy.
      allow read: if true;

      // Only authenticated users may write; max 15 MB; images or common docs.
      // text/html and text/javascript blocked — XSS vector when served inline.
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && (
          request.resource.contentType.matches('image/(png|jpeg|gif|webp)')
          || request.resource.contentType.matches('audio/.*')
          || request.resource.contentType.matches('video/.*')
          || request.resource.contentType == 'application/pdf'
          || request.resource.contentType.matches('application/.*officedocument.*')
          || request.resource.contentType == 'application/msword'
          || request.resource.contentType == 'application/vnd.ms-excel'
          || request.resource.contentType == 'application/vnd.ms-powerpoint'
          || request.resource.contentType == 'text/plain'
          || request.resource.contentType == 'text/csv'
        );
    }

    // Legacy "shared" path used when no teamId is set yet
    match /shared/{folder}/{fileName} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 15 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
