# Variables mjedisi për VPS Server — kopjo si .env

# Çelësi sekret i API (duhet të jetë i njëjtë me WHATSAPP_VPS_SECRET në Vercel)
API_SECRET=vendos-nje-password-te-forte-ketu

# ID e ekipit (nga Firestore — teams/{TEAM_ID})
TEAM_ID=team-id-nga-firestore

# Porta ku do të dëgjojë serveri (default: 3001)
PORT=3001

# Firebase Service Account JSON (alternativë: vendo skedarin firebase-service-account.json)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Cron scheduling (zëvendëson cron-in e Vercel) ──────────────────────────────
# URL-ja e aplikacionit në Vercel (pa "/" në fund).
CRM_BASE_URL=https://fivocrm.vercel.app

# I NJËJTI çelës si CRON_SECRET te Vercel (Settings → Environment Variables).
# Nëse mungon ose nuk përputhet, punët me orar çaktivizohen / kthejnë 401.
CRON_SECRET=i-njejti-si-ne-vercel

# Opsionale: ora (UTC) kur ekzekutohet "run-all" ditor (default 8 = 08:00 UTC).
# CRON_DAILY_HOUR=8
