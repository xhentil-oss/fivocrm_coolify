# Variables mjedisi për VPS Server — kopjo si .env

# Çelësi sekret i API (duhet të jetë i njëjtë me WHATSAPP_VPS_SECRET në Vercel)
API_SECRET=vendos-nje-password-te-forte-ketu

# ID e ekipit (nga Firestore — teams/{TEAM_ID})
TEAM_ID=team-id-nga-firestore

# Porta ku do të dëgjojë serveri (default: 3001)
PORT=3001

# Firebase Service Account JSON (alternativë: vendo skedarin firebase-service-account.json)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ── Cron scheduling (zëvendëson cron-in e Vercel) ──────────────────────────────
# URL-ja e aplikacionit në Vercel (pa "/" në fund).
CRM_BASE_URL=https://fivocrm.vercel.app

# I NJËJTI çelës si CRON_SECRET te Vercel (Settings → Environment Variables).
# Nëse mungon ose nuk përputhet, punët me orar çaktivizohen / kthejnë 401.
CRON_SECRET=i-njejti-si-ne-vercel

# Opsionale: ora (UTC) kur ekzekutohet "run-all" ditor (default 8 = 08:00 UTC).
# CRON_DAILY_HOUR=8

# ── Siguri ─────────────────────────────────────────────────────────────────────
# Origjinat (browser) që lejohen të thërrasin këtë server (CORS), të ndara me presje.
# `*.` në fillim = çdo nën-domain. Thirrjet server-me-server (Vercel → VPS) nuk
# dërgojnë Origin dhe nuk preken. Default kur mungon:
#   https://fivocrm.vercel.app,https://fivocrm.com,https://*.fivocrm.com
# (+ capacitor://localhost, https://localhost, http://localhost:5173 kur NODE_ENV != production)
# CORS_ORIGINS=https://fivocrm.vercel.app,https://fivocrm.com,https://*.fivocrm.com

# Vendos NODE_ENV=production në VPS: fik origjinat localhost në CORS dhe
# refuzon CRM_BASE_URL me http://.
NODE_ENV=production

# Logu i WhatsApp: default vetëm 4 shifrat e fundit të numrit + gjatësia e mesazhit.
# WA_LOG_BODIES=1 shkruan numrin e plotë dhe tekstin (vetëm për debug të përkohshëm).
# WA_LOG_BODIES=0

# URL e WHMCS (pa "/includes/api.php"). /whmcs-proxy dërgon VETËM këtu — URL-ja
# nga kërkesa injorohet.
# WHMCS_API_URL=https://billing.example.com
