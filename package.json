{
  "version": "1.0.0",
  "engines": {
    "node": "24.x"
  },
  "source": "./index.html",
  "type": "module",
  "name": "anima-project",
  "description": "A React project automatically generated by Anima",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx}\"",
    "_comment_typecheck": "Root tsconfig.json is a SOLUTION file (files: [] + references), so `tsc --noEmit` on it checks NOTHING and reports success. Always typecheck a real project. `vite build` does not type-check either (esbuild strips types). Note: the app project currently has pre-existing errors, so this is not yet a clean pass/fail gate — compare the count before/after a change.",
    "typecheck": "tsc -p tsconfig.app.json",
    "typecheck:api": "tsc -p tsconfig.api.json",
    "typecheck:all": "tsc -p tsconfig.app.json && tsc -p tsconfig.node.json && tsc -p tsconfig.api.json",
    "test": "vitest run",
    "_comment_test:rules": "Firestore rules gate. Needs the emulator: JDK 21+ for firebase-tools 14+, or JDK 17 with `npx -y firebase-tools@13`. MUST pass before `firebase deploy --only firestore:rules`.",
    "test:rules": "firebase emulators:exec --only firestore --project fivocrm-rules-test \"node --test scripts/firestore-rules.test.mjs\"",
    "test:rules:jdk17": "npx -y firebase-tools@13 emulators:exec --only firestore --project fivocrm-rules-test \"node --test scripts/firestore-rules.test.mjs\"",
    "test:watch": "vitest",
    "android:add": "npx cap add android && npm run android:configure",
    "android:configure": "node scripts/android-configure.cjs",
    "android:sync": "vite build && npx cap sync android && npm run android:configure",
    "android:open": "npx cap open android",
    "android:run": "npx cap run android",
    "android:aab": "npm run android:sync && cd android && .\\gradlew.bat bundleRelease",
    "ios:add": "npx cap add ios && npm run ios:configure",
    "ios:configure": "node scripts/ios-configure.cjs",
    "ios:sync": "vite build && npx cap sync ios && npm run ios:configure",
    "ios:open": "npx cap open ios",
    "ios:run": "npx cap run ios",
    "test:rules:storage": "firebase emulators:exec --only storage --project fivocrm-rules-test \"node --test scripts/storage-rules.test.mjs\""
  },
