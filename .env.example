# Firebase Configuration
# Get these values from Firebase Console > Project Settings
VITE_FIREBASE_API_KEY=your-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
# Web push (FCM). WITHOUT this key no web push is ever delivered — staff and portal.
# Firebase Console → Project settings → Cloud Messaging → Web Push certificates.
VITE_FIREBASE_VAPID_KEY=your-web-push-vapid-key

# SMTP Configuration (for email invitations)
SMTP_HOST=mail.yourdomain.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=noreply@yourdomain.com
SMTP_PASS=your-smtp-password

# Stripe Configuration
# Publishable key (safe for frontend, starts with pk_live_ or pk_test_)
VITE_STRIPE_PUBLISHABLE_KEY=pk_test_your-publishable-key
# Secret key (SERVER ONLY - NEVER expose in frontend, starts with sk_live_ or sk_test_)
STRIPE_SECRET_KEY=sk_test_your-secret-key
# Webhook signing secret (SERVER ONLY - from Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_your-webhook-secret

# Platform Super Admin (comma-separated emails — bypass ALL team filters, see all data)
VITE_SUPER_ADMIN_EMAILS=owner@example.com

# Default tenant for NEW portal clients on the apex / *.vercel.app host (no portal
# subdomain to resolve). Set BOTH to the MAIN tenant's ids so self-registering
# clients land in the primary business instead of an arbitrary one. Find them in
# Firestore: teamMembers → the main team's `teamId` and `businessId`.
VITE_DEFAULT_TEAM_ID=your-main-team-id
VITE_DEFAULT_BUSINESS_ID=your-main-business-id

# Social Media module (Meta — Facebook Pages + Instagram insights)
# Create a Meta app at developers.facebook.com → add the Facebook Login product.
# Requires App Review + Business Verification for the advanced permissions
# (instagram_manage_insights, pages_read_engagement, read_insights, business_management)
# before it can read insights of accounts you don't own.
META_APP_ID=your-meta-app-id
META_APP_SECRET=your-meta-app-secret
# OAuth redirect — must EXACTLY match a "Valid OAuth Redirect URI" in the app
# settings. Defaults to https://<host>/api/social?action=oauth-callback if unset.
SOCIAL_OAUTH_REDIRECT=https://fivocrm.vercel.app/api/social?action=oauth-callback
# App origin used to redirect back to the UI after OAuth (defaults to request host).
APP_URL=https://fivocrm.vercel.app

# Google Search Console (website search-visibility report). Reuses the existing
# Google Cloud OAuth client (VITE_GOOGLE_CLIENT_ID). Add a server-side secret, then
# in Google Cloud Console: enable the "Google Search Console API" and add the
# redirect URI below to the OAuth client. Scope webmasters.readonly is "sensitive"
# → needs Google verification for external clients (testing mode allows 100 users).
GOOGLE_CLIENT_ID=your-google-oauth-client-id          # optional; falls back to VITE_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GSC_OAUTH_REDIRECT=https://fivocrm.vercel.app/api/social?action=google-callback

# WHMCS sync target tenant (SERVER/VPS — where the cron/sync runs). The sync now
# self-derives a team that belongs to the WHMCS business, but set these for a
# deterministic target. Use the MAIN tenant's ids (same as the VITE_DEFAULT_* above).
WHMCS_TEAM_ID=your-main-team-id
WHMCS_BUSINESS_ID=your-main-business-id
